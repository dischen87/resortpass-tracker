www.resortpass-europapark.ch {
	# Serve static Astro build
	root * /srv/www

	# Proxy API requests to Bun server
	handle /api/* {
		reverse_proxy resortpass-api:3000
	}

	# Keep the conventional sitemap URL machine-readable.
	redir /sitemap.xml /sitemap-index.xml 308

	# Redirect duplicate static-page URLs to Astro's canonical trailing-slash form.
	@explicitIndex path_regexp explicit_index ^(.*/)index\.html$
	redir @explicitIndex {re.explicit_index.1} 308

	@directoryWithoutSlash {
		not path /api/* */
		file {path}/index.html
	}
	redir @directoryWithoutSlash {path}/ 308

	# Astro is a static multi-page site. Missing files must stay 404s.
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Serve the 404 page with the 404 status.
	#
	# Without the `status` argument `file_server` answers 200, because as far as
	# it is concerned it successfully served /404.html. Production is doing
	# exactly that today: every invented URL returns 200 with the German home
	# page and `index, follow`, which is an unbounded duplicate-content
	# generator and makes redirects impossible to verify.
	handle_errors 404 {
		rewrite /404.html
		file_server {
			status {err.status_code}
		}
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# X-XSS-Protection is deliberately absent: the filter it enabled has been
		# removed from every current browser, and in its last versions it could
		# itself be abused. Content-Type-Options plus a real CSP is the successor.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Astro content-hashed bundles are safe to cache immutably.
	@hashedAssets path /_astro/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# Fixed-name images and fonts can change between deploys, so keep their cache short.
	@fixedImages {
		not path /_astro/*
		path *.svg *.png *.jpg *.jpeg *.webp *.avif *.ico
	}
	header @fixedImages Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@fixedFonts {
		not path /_astro/*
		path *.woff *.woff2
	}
	header @fixedFonts Cache-Control "public, max-age=604800"

	# Short cache for status.json
	@status path /api/status.json
	header @status Cache-Control "public, max-age=60"

	# zstd first: Caddy offers encodings in the order listed, and browsers that
	# accept both were being handed gzip — a measurably larger payload.
	encode zstd gzip

	log {
		output file /var/log/caddy/resortpass-access.log {
			roll_size 10MiB
			roll_keep 3
			# Access logs contain IP addresses. A size-based cap alone is not a
			# retention policy; this bounds how long they can exist at all and is
			# what the privacy statement refers to.
			roll_keep_for 14d
		}
	}
}

resortpass-europapark.ch {
	redir https://www.resortpass-europapark.ch{uri} permanent
}

www.resortpass-europapark.ch {
	# Serve static Astro build
	root * /srv/www

	# Proxy API requests to Bun server
	handle /api/* {
		reverse_proxy resortpass-api:3000
	}

	# Keep the conventional sitemap URL machine-readable.
	redir /sitemap.xml /sitemap-index.xml 308

	# Astro is a static multi-page site. Missing files must stay 404s.
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite /404.html
		file_server
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-XSS-Protection "1; mode=block"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Cache static assets
	@static path *.css *.js *.svg *.png *.jpg *.woff2 *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Short cache for status.json
	@status path /api/status.json
	header @status Cache-Control "public, max-age=60"

	encode gzip zstd

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

resortpass-europapark.ch {
	redir https://www.resortpass-europapark.ch{uri} permanent
}

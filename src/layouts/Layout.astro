---
import { type Lang, defaultLang, languages, getTranslation } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: Lang;
  noindex?: boolean;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);

const title = Astro.props.title || tr('meta.title');
const description = Astro.props.description || tr('meta.description');
const siteUrl = "https://www.resortpass-europapark.ch";
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentUrl = Astro.props.canonical || `${siteUrl}${rawPath}`;
const noindex = Astro.props.noindex || false;

const localeMap: Record<Lang, string> = {
  de: 'de_CH',
  fr: 'fr_CH',
  it: 'it_CH',
  en: 'en_US',
};

function getPathForLang(targetLang: Lang): string {
  const path = Astro.url.pathname;
  let cleanPath = path;
  for (const l of languages) {
    if (l !== defaultLang && (path.startsWith(`/${l}/`) || path === `/${l}`)) {
      cleanPath = path.slice(l.length + 1) || '/';
      break;
    }
  }
  if (!cleanPath.endsWith('/')) cleanPath += '/';
  if (targetLang === defaultLang) return cleanPath;
  return `/${targetLang}${cleanPath}`;
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={currentUrl} />

  <!-- hreflang for all languages -->
  {!noindex && languages.map((l) => (
    <link rel="alternate" hreflang={l} href={`${siteUrl}${getPathForLang(l)}`} />
  ))}
  {!noindex && <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getPathForLang(defaultLang)}`} />}
  <link rel="alternate" type="application/rss+xml" title="ResortPass availability feed" href={`/api/feed.xml?lang=${lang}`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={tr('meta.og_alt')} />
  <meta property="og:site_name" content="ResortPass Tracker" />
  <meta property="og:locale" content={localeMap[lang]} />
  {languages.filter(l => l !== lang).map(l => (
    <meta property="og:locale:alternate" content={localeMap[l]} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

  <!-- Theme Color -->
  <meta name="theme-color" content="#FFFFFF" />
  <meta name="color-scheme" content="light" />

  <!-- Favicon & Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Font Preload (LCP) -->
  <link rel="preload" href="/fonts/DMSans-Regular.woff2" as="font" type="font/woff2" crossorigin />

  <meta name="author" content="Mathias Graf" />

  <title>{title}</title>
</head>
<body class="min-h-screen bg-bg text-text-primary antialiased">
  <a class="skip-link" href="#main-content">{tr('nav.skip')}</a>
  <div class="top-bar"></div>
  <slot />
</body>
</html>

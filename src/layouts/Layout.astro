---
import {
  defaultLocale,
  getLocaleDefinition,
  type LocaleCode,
} from '../i18n/locales';
import {
  resolveRouteAlternates,
  type RouteKey,
  type RoutePaths,
} from '../i18n/routes';
import { getTranslation } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: LocaleCode;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  /** Semantic route identifier. Usually inferred from the current pathname. */
  routeKey?: RouteKey;
  /** Backwards-compatible explicit publication map for localized route variants. */
  alternatePaths?: RoutePaths;
  /** Localized skip-link label for pages outside the legacy four-language UI. */
  skipLinkLabel?: string;
}

const lang = Astro.props.lang || defaultLocale;
const locale = getLocaleDefinition(lang);
const tr = (key: string) => getTranslation(lang, key);

const title = Astro.props.title || tr('meta.title');
const description = Astro.props.description || tr('meta.description');
const ogImage = Astro.props.ogImage || '/og-resortpass-v3.png';
const ogImageAlt = Astro.props.ogImageAlt || tr('meta.og_alt');
const siteUrl = "https://www.resortpass-europapark.ch";
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentUrl = Astro.props.canonical || `${siteUrl}${rawPath}`;
const noindex = Astro.props.noindex || false;
const alternatePaths = Astro.props.alternatePaths;
const resolvedRoute = resolveRouteAlternates({
  pathname: Astro.url.pathname,
  routeKey: Astro.props.routeKey,
  explicitPaths: alternatePaths,
});
const alternateLinks = noindex ? [] : resolvedRoute.alternates;
const xDefaultPath = noindex ? undefined : resolvedRoute.xDefaultPath;
const rssLang = lang;
const skipLinkLabel = Astro.props.skipLinkLabel || tr('nav.skip');
---

<!DOCTYPE html>
<html lang={locale.bcp47} dir={locale.direction}>
<head>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta
    name="robots"
    content={noindex
      ? 'noindex, nofollow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
  />
  <link rel="canonical" href={currentUrl} />

  <!-- Only published, reciprocal language variants are advertised. -->
  {alternateLinks.map(({ locale: alternateLocale, path }) => (
    <link
      rel="alternate"
      hreflang={getLocaleDefinition(alternateLocale).hreflang}
      href={`${siteUrl}${path}`}
    />
  ))}
  {xDefaultPath && <link rel="alternate" hreflang="x-default" href={`${siteUrl}${xDefaultPath}`} />}
  <link rel="alternate" type="application/rss+xml" title="ResortPass availability feed" href={`/api/feed.xml?lang=${rssLang}`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:site_name" content="ResortPass Tracker" />
  <meta property="og:locale" content={locale.ogLocale} />
  {alternateLinks.filter(link => link.locale !== lang).map(link => (
    <meta property="og:locale:alternate" content={getLocaleDefinition(link.locale).ogLocale} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Theme Color -->
  <meta name="theme-color" content="#FFF9F0" />
  <meta name="color-scheme" content="light" />

  <!-- Favicon & Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Font Preload (LCP). One variable file now serves every weight, so the
       previously unpreloaded bold no longer causes a second-wave reflow. -->
  <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin />

  <meta name="author" content="Mathias Graf" />

  <title>{title}</title>
</head>
<body class="min-h-screen bg-bg text-text-primary antialiased">
  <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
  <div class="top-bar"></div>
  <slot />
</body>
</html>

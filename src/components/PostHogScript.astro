---
// PostHog Analytics - deferred loading
// Loads after 3s idle or on first user interaction (whichever comes first)
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST;
---

{posthogKey && posthogHost && (
  <script
    is:inline
    data-posthog-key={posthogKey}
    data-posthog-host={posthogHost}
  >
    (function() {
      var loaded = false;
      var script = document.currentScript;
      var key = script.getAttribute('data-posthog-key');
      var host = script.getAttribute('data-posthog-host');

      function loadPostHog() {
        if (loaded) return;
        loaded = true;

        // Load PostHog JS from CDN (self-hosted hobby doesn't serve static JS)
        var s = document.createElement('script');
        s.type = 'text/javascript';
        s.crossOrigin = 'anonymous';
        s.async = true;
        s.src = 'https://us-assets.i.posthog.com/static/array.js';
        document.head.appendChild(s);
        s.onload = function() {
          if (window.posthog) {
            window.posthog.init(key, {
              api_host: host,
              ui_host: 'https://us.posthog.com',
              autocapture: true,
              capture_pageview: true,
              capture_pageleave: true,
              disable_external_dependency_loading: true,
            advanced_disable_feature_flags: true,
            disable_surveys: true,
              enable_recording_console_log: false,
              session_recording: {
                recordCrossOriginIframes: false,
              },
              persistence: 'localStorage+cookie',
              loaded: function(posthog) {
                if (import.meta.env.DEV) {
                  posthog.opt_out_capturing();
                }
              }
            });
          }
        };
      }

      // Load after 3s idle or first interaction
      var timer = setTimeout(loadPostHog, 1500);
      var events = ['click', 'scroll', 'keydown', 'touchstart'];
      function onInteraction() {
        clearTimeout(timer);
        events.forEach(function(e) {
          document.removeEventListener(e, onInteraction, { capture: true });
        });
        loadPostHog();
      }
      events.forEach(function(e) {
        document.addEventListener(e, onInteraction, { capture: true, once: true });
      });
    })();
  </script>
)}

---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';
import { getPlanningPack } from '../content/planning';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const pack = getPlanningPack(lang);

/**
 * Six finished planning tools that the home page never mentioned.
 *
 * A visitor arriving for "when can I buy a pass" left again without ever
 * learning that the site can also plan their trip — none of these routes were
 * reachable from the home page at all, in any language.
 *
 * Built entirely from the planning packs, which already exist in all 17
 * languages, so this ships everywhere at once rather than waiting on new copy.
 */
const tools = [
  { route: 'visitPlanner' as const, icon: 'tabler:calendar-week' },
  { route: 'costCalculator' as const, icon: 'tabler:calculator' },
  { route: 'familyGuide' as const, icon: 'tabler:mood-kid' },
  { route: 'rulanticaGuide' as const, icon: 'tabler:swimming' },
  { route: 'stayGuide' as const, icon: 'tabler:bed' },
  { route: 'restaurantGuide' as const, icon: 'tabler:tools-kitchen-2' },
]
  .map((tool) => ({ ...tool, href: getRoutePath(tool.route, lang), page: pack.pages[tool.route] }))
  .filter((tool) => Boolean(tool.href && tool.page));

const hubPath = getRoutePath('parkGuide', lang);
const hubPage = pack.pages.parkGuide;
---

{tools.length > 0 && (
  <section class="planning-teaser" id="planen" aria-labelledby="planning-teaser-title">
    <div class="section-shell">
      <div class="planning-teaser__head">
        <p class="planning-teaser__eyebrow">{hubPage.eyebrow}</p>
        <h2 id="planning-teaser-title" class="section-heading">{pack.common.plannerLabel}</h2>
      </div>

      <ul class="planning-teaser__grid">
        {tools.map((tool) => (
          <li>
            <a href={tool.href}>
              <span class="planning-teaser__icon" aria-hidden="true">
                <Icon name={tool.icon} class="h-5 w-5" />
              </span>
              <span class="planning-teaser__body">
                <span class="planning-teaser__label">{tool.page.eyebrow}</span>
                <span class="planning-teaser__question">{tool.page.heading}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      {hubPath && (
        <p class="planning-teaser__all">
          <a href={hubPath}>
            {hubPage.eyebrow}
            <Icon name="tabler:arrow-right" class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
          </a>
        </p>
      )}
    </div>
  </section>
)}

<style>
  .planning-teaser {
    padding-block: var(--space-section);
    border-block-start: 2px solid var(--color-border-light);
    background: var(--color-surface-light);
  }
  .planning-teaser__head { margin-bottom: 1.5rem; }
  .planning-teaser__eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .planning-teaser__grid {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .planning-teaser__grid a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    height: 100%;
    border: 3px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--elev-1);
    padding: 1rem 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }
  .planning-teaser__grid a:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--elev-3);
  }
  .planning-teaser__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-light);
    color: var(--color-accent);
    flex: none;
  }
  .planning-teaser__body { display: grid; gap: 0.2rem; min-width: 0; }
  .planning-teaser__label {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  /* The question is the label: people scan for the one they are asking. */
  .planning-teaser__question {
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .planning-teaser__all { margin-top: 1.25rem; }
  .planning-teaser__all a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .planning-teaser__all a:hover { text-decoration: underline; }

  @media (min-width: 640px) {
    .planning-teaser__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .planning-teaser__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .planning-teaser__grid a { transition: none; }
    .planning-teaser__grid a:hover { transform: none; }
  }
</style>

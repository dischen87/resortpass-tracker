---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import BrandSafeText from './BrandSafeText.astro';
import { crowdCalendarPaths, type Lang, getTranslation } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';
import { getLocaleDefinition } from '../i18n/locales';
import { rideLands, ridesByLand, rides, rideSearchTerms } from '../data/rides';
import { landNameMap } from '../i18n/lands';
import '../styles/global.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = (key: string) => getTranslation(lang, key);
const siteUrl = 'https://www.resortpass-europapark.ch';
const pagePath = getRoutePath('waitTimes', lang)!;
const homePath = getRoutePath('home', lang)!;
const crowdCalendarPath = crowdCalendarPaths[lang];
const breadcrumbNames: [string, string] = [tr('nav.home'), tr('nav.wait_times')];

/**
 * Evergreen answers first. A crawler or answer engine never runs the live
 * island, so every question here is answered from facts that hold regardless of
 * what the feed currently says.
 */
const faqItems = [
  [tr('wait.faq_current_q'), tr('wait.faq_current_a')],
  [tr('wait.faq_popular_q'), tr('wait.faq_popular_a')],
  [tr('wait.faq_closed_q'), tr('wait.faq_closed_a')],
  [tr('wait.faq_best_time_q'), tr('wait.faq_best_time_a')],
  [tr('wait.faq_update_q'), tr('wait.faq_update_a')],
  [tr('wait.faq_app_q'), tr('wait.faq_app_a')],
  [tr('wait.faq_official_q'), tr('wait.faq_official_a')],
];

const officialAppUrls: Partial<Record<Lang, string>> = {
  de: 'https://www.europapark.de/de/freizeitpark/infos/media-unterhaltung/europa-park-rulantica-app',
  fr: 'https://www.europapark.de/fr/parc-de-loisirs/infos/medias-et-divertissements/appli-europa-park-rulantica',
  it: 'https://www.europapark.de/it/parco-divertimenti/info/media-intrattenimento/app-europa-park-rulantica',
  en: 'https://www.europapark.de/en/theme-park/info/media-entertainment/europa-park-rulantica-app',
};
const officialAppUrl = officialAppUrls[lang] || officialAppUrls.en!;
const localeTag = getLocaleDefinition(lang).bcp47;

const landNames = landNameMap(lang, rideLands);
const landGroups = ridesByLand();
const headliners = rides.filter((ride) => ride.headliner);

/** Search index for the client, built once at build time. */
const searchIndex = Object.fromEntries(
  rides.map((ride) => [
    ride.slug,
    [...rideSearchTerms(ride), landNames[ride.land]].join(' ').toLocaleLowerCase(localeTag),
  ]),
);

const clientCopy = {
  live: tr('wait.live'),
  stale: tr('wait.stale'),
  updated: tr('wait.updated'),
  minutes: tr('wait.minutes'),
  openNow: tr('wait.open_now'),
  closed: tr('wait.closed'),
  down: tr('wait.status_down'),
  refurbishment: tr('wait.status_refurbishment'),
  noWaitReported: tr('wait.no_wait_reported'),
  results: tr('wait.results'),
  noResults: tr('wait.no_results'),
  open: tr('wait.open'),
  average: tr('wait.average'),
  longest: tr('wait.longest'),
  rides: tr('wait.rides'),
  stateOpen: tr('wait.state_open'),
  stateOpensIn: tr('wait.state_opens_in'),
  stateOpensToday: tr('wait.state_opens_today'),
  stateClosedToday: tr('wait.state_closed_today'),
  stateAfterClose: tr('wait.state_after_close'),
  stateSeasonBreak: tr('wait.state_season_break'),
  stateNextDay: tr('wait.state_next_day'),
  closesAt: tr('wait.closes_at'),
  crowdToday: tr('wait.crowd_today'),
  seasonBreakText: tr('wait.season_break_text'),
  unreliableTitle: tr('wait.unreliable_title'),
  unreliableText: tr('wait.unreliable_text'),
  errorTitle: tr('wait.error_title'),
  errorText: tr('wait.error_text'),
  opensAtShort: tr('wait.opens_at_short'),
  shortestNow: tr('wait.shortest_now'),
  groupSummary: tr('wait.group_summary'),
  groupClosed: tr('wait.group_closed'),
  favoritesTitle: tr('wait.favorites_title'),
  favoriteAdd: tr('wait.favorite_add'),
  favoriteRemove: tr('wait.favorite_remove'),
  levels: [
    tr('wait.level_very_short'),
    tr('wait.level_short'),
    tr('wait.level_normal'),
    tr('wait.level_long'),
    tr('wait.level_very_long'),
  ],
};
---

<Layout lang={lang} routeKey="waitTimes" title={tr('wait.meta_title')} description={tr('wait.meta_description')} ogImage="/og-wartezeiten-v3.png" ogImageAlt={tr('wait.og_alt')}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${siteUrl}${pagePath}#webpage`,
        url: `${siteUrl}${pagePath}`,
        name: tr('wait.meta_title'),
        description: tr('wait.meta_description'),
        inLanguage: localeTag,
        primaryImageOfPage: {
          '@type': 'ImageObject',
          contentUrl: `${siteUrl}/og-wartezeiten-v3.png`,
          width: 1200,
          height: 630,
          caption: tr('wait.og_alt'),
          representativeOfPage: true,
        },
        isPartOf: { '@type': 'WebSite', name: 'ResortPass Tracker', url: siteUrl },
        breadcrumb: { '@id': `${siteUrl}${pagePath}#breadcrumb` },
        about: { '@id': `${siteUrl}/#europa-park` },
      },
      {
        '@type': 'BreadcrumbList',
        '@id': `${siteUrl}${pagePath}#breadcrumb`,
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: breadcrumbNames[0], item: `${siteUrl}${homePath}` },
          { '@type': 'ListItem', position: 2, name: breadcrumbNames[1], item: `${siteUrl}${pagePath}` },
        ],
      },
      {
        '@type': 'FAQPage',
        '@id': `${siteUrl}${pagePath}#faq`,
        mainEntity: faqItems.map(([name, text]) => ({
          '@type': 'Question',
          name,
          acceptedAnswer: { '@type': 'Answer', text },
        })),
      },
    ],
  })} />

  <Navbar lang={lang} />

  <main id="main-content">
    <section class="wait-hero">
      <div class="blob blob-blue w-72 h-72 -top-32 -right-28" aria-hidden="true"></div>
      <div class="section-shell wait-hero__inner">
        <h1 class="wait-hero__title"><BrandSafeText text={tr('wait.title')} /></h1>
        <p class="wait-hero__sub">{tr('wait.subtitle')}</p>
      </div>
    </section>

    <!-- The state band replaces the old "Live-Daten" pill: it always says
         something true, including at 03:00 and during the season break. -->
    <div id="park-band" class="park-band" data-state="loading">
      <div class="section-shell park-band__inner">
        <p class="park-band__state">
          <span class="park-band__dot" aria-hidden="true"></span>
          <span id="park-band-text">{tr('wait.loading')}</span>
        </p>
        <p id="park-band-meta" class="park-band__meta"></p>
        <button id="refresh-wait-times" type="button" class="park-band__refresh" aria-label={tr('wait.refresh')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-3.5-7.1" /><path d="M21 3v6h-6" />
          </svg>
        </button>
      </div>
    </div>

    <section class="section-shell wait-stats-section" aria-labelledby="wait-summary-title">
      <h2 id="wait-summary-title" class="sr-only">{tr('wait.summary_title')}</h2>
      <div id="wait-stats" class="wait-stats" hidden>
        <article class="stat"><p class="stat__label">{tr('wait.open')}</p><p class="stat__value"><strong id="open-rides">—</strong> <span class="stat__unit">{tr('wait.rides')}</span></p></article>
        <article class="stat"><p class="stat__label">{tr('wait.average')}</p><p class="stat__value"><strong id="average-wait">—</strong> <span id="average-wait-unit" class="stat__unit" hidden>{tr('wait.minutes')}</span></p></article>
        <article class="stat"><p class="stat__label">{tr('wait.longest')}</p><p class="stat__value"><strong id="longest-wait">—</strong> <span id="longest-wait-unit" class="stat__unit" hidden>{tr('wait.minutes')}</span></p></article>
      </div>
      <div id="wait-schedule" class="wait-schedule" hidden></div>
    </section>

    <section class="section-shell wait-list-section" aria-labelledby="ride-list-title">
      <div id="wait-notice" class="wait-notice" role="status" hidden>
        <strong id="wait-notice-title"></strong>
        <span id="wait-notice-text"></span>
      </div>

      <div id="shortest-now" class="shortest" hidden>
        <h2 class="shortest__title">{tr('wait.shortest_now')}</h2>
        <ul id="shortest-list" class="shortest__list"></ul>
      </div>

      <div class="wait-toolbar">
        <label class="wait-toolbar__search">
          <span class="wait-toolbar__label">{tr('wait.search_label')}</span>
          <input id="ride-search" type="search" autocomplete="off" placeholder={tr('wait.search_placeholder')} />
        </label>
        <fieldset class="wait-toolbar__filters">
          <legend class="wait-toolbar__label">{tr('wait.filter_label')}</legend>
          <div class="filter-group" id="ride-filters">
            <button type="button" data-filter="all" aria-pressed="true">{tr('wait.filter_all')} <span class="filter-count" data-count="all"></span></button>
            <button type="button" data-filter="open" aria-pressed="false">{tr('wait.filter_open')} <span class="filter-count" data-count="open"></span></button>
            <button type="button" data-filter="quick" aria-pressed="false">{tr('wait.filter_quick')} <span class="filter-count" data-count="quick"></span></button>
            <button type="button" data-filter="favorites" aria-pressed="false">{tr('wait.filter_favorites')} <span class="filter-count" data-count="favorites"></span></button>
          </div>
        </fieldset>
        <label class="wait-toolbar__sort">
          <span class="wait-toolbar__label">{tr('wait.sort_label')}</span>
          <select id="ride-sort">
            <option value="land">{tr('wait.sort_land')}</option>
            <option value="longest">{tr('wait.sort_longest')}</option>
            <option value="shortest">{tr('wait.sort_shortest')}</option>
            <option value="name">{tr('wait.sort_name')}</option>
          </select>
        </label>
      </div>

      <div class="wait-list-head">
        <div>
          <h2 id="ride-list-title">{tr('wait.directory_title')}</h2>
          <p class="wait-list-head__desc">{tr('wait.directory_desc')}</p>
        </div>
        <p id="result-count" class="wait-list-head__count" role="status">{tr('wait.results').replace('{count}', String(rides.length))}</p>
      </div>

      <!--
        The full directory is rendered at build time, grouped by themed area.
        It is the page's substance when the park is closed, when the provider
        fails, and for every crawler — none of which run the island below.
      -->
      <div id="ride-directory" class="ride-directory">
        {landGroups.map((group) => (
          <section class="land-group" data-land={group.land}>
            <h3 class="land-group__head" id={`land-${group.land.toLowerCase().replace(/\s+/g, '-')}`}>
              <span class="land-group__name">{landNames[group.land]}</span>
              <span class="land-group__meta" data-land-meta={group.land}></span>
            </h3>
            <ul class="ride-rows">
              {group.rides.map((ride) => (
                <li class="ride-row" id={`ride-${ride.slug}`} data-slug={ride.slug} data-land={group.land} data-headliner={ride.headliner ? 'true' : undefined}>
                  <span class="ride-row__stripe" data-level="idle" aria-hidden="true"></span>
                  <span class="ride-row__body">
                    <span class="ride-row__name">{ride.name}</span>
                    <span class="ride-row__meta" data-role="status"></span>
                    <span class="ride-row__bar" aria-hidden="true"><span class="ride-row__bar-fill" style="--pct:0"></span></span>
                  </span>
                  <span class="ride-row__wait" data-role="wait"></span>
                  <button type="button" class="ride-row__fav" data-role="fav" data-slug={ride.slug} aria-pressed="false" hidden>
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
                      <path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.8l5.9-.9z" />
                    </svg>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <p id="wait-empty" class="wait-empty" hidden>{tr('wait.no_results')}</p>
      <p id="favorites-note" class="favorites-note" hidden>{tr('wait.favorites_note')}</p>

      <div class="wait-source">
        <p>{tr('wait.source_note')}</p>
        <p>
          <a href="https://parkqueuetimes.com/" target="_blank" rel="noopener noreferrer">Powered by ParkQueueTimes.com</a>
          <span aria-hidden="true"> · </span>
          <a href={officialAppUrl} target="_blank" rel="noopener noreferrer">{tr('wait.official_app')}</a>
        </p>
        <p><a href={crowdCalendarPath} class="btn-secondary btn-secondary--inline">{tr('wait.forecast_cta')}</a></p>
      </div>
    </section>

    <section class="wait-explainer">
      <div class="section-shell section-shell--narrow">
        <h2>{tr('wait.explainer_title')}</h2>
        <div class="wait-explainer__grid">
          <article class="glass-card p-6">
            <h3>{tr('wait.explainer_live_title')}</h3>
            <p>{tr('wait.explainer_live_text')}</p>
          </article>
          <article class="glass-card p-6">
            <h3>{tr('wait.explainer_use_title')}</h3>
            <p>{tr('wait.explainer_use_text')}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-shell section-shell--narrow wait-faq" aria-labelledby="wait-faq-title">
      <h2 id="wait-faq-title">{tr('wait.faq_title')}</h2>
      <div class="wait-faq__grid">
        {faqItems.map(([question, answer]) => (
          <article class="glass-card p-6">
            <h3>{question}</h3>
            <p>{answer}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script define:vars={{ localeTag, clientCopy, searchIndex, headlinerSlugs: headliners.map((r) => r.slug) }}>
    const locale = localeTag;
    const FAVORITES_KEY = 'rp.fav.rides';
    /** Shared 0–120 minute axis so bar lengths are comparable across rides. */
    const BAR_SCALE_MAX = 120;
    /** Five bands: the old three made a 35-minute queue look like a 120-minute one. */
    const LEVEL_THRESHOLDS = [10, 25, 45, 70];

    const timeFormat = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });
    const dayFormat = new Intl.DateTimeFormat(locale, { weekday: 'short', day: '2-digit', month: '2-digit' });

    const band = document.querySelector('#park-band');
    const bandText = document.querySelector('#park-band-text');
    const bandMeta = document.querySelector('#park-band-meta');
    const stats = document.querySelector('#wait-stats');
    const schedule = document.querySelector('#wait-schedule');
    const notice = document.querySelector('#wait-notice');
    const noticeTitle = document.querySelector('#wait-notice-title');
    const noticeText = document.querySelector('#wait-notice-text');
    const shortest = document.querySelector('#shortest-now');
    const shortestList = document.querySelector('#shortest-list');
    const directory = document.querySelector('#ride-directory');
    const emptyMessage = document.querySelector('#wait-empty');
    const favoritesNote = document.querySelector('#favorites-note');
    const search = document.querySelector('#ride-search');
    const sortSelect = document.querySelector('#ride-sort');
    const filterButtons = [...document.querySelectorAll('#ride-filters button')];
    const resultCount = document.querySelector('#result-count');
    const refreshButton = document.querySelector('#refresh-wait-times');

    const rows = [...document.querySelectorAll('.ride-row')];
    const rowBySlug = new Map(rows.map((row) => [row.dataset.slug, row]));
    const groups = [...document.querySelectorAll('.land-group')];

    /** provider name -> slug, filled from the payload so we never guess. */
    let liveBySlug = new Map();
    let parkState = 'loading';
    let activeFilter = 'all';
    let favorites = readFavorites();
    let countdownTimer = null;

    function readFavorites() {
      try {
        const raw = localStorage.getItem(FAVORITES_KEY);
        return new Set(raw ? JSON.parse(raw) : []);
      } catch {
        return new Set();
      }
    }

    function writeFavorites() {
      try {
        localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites]));
      } catch {
        // Private mode or a full quota. Favourites simply stay session-only.
      }
    }

    function fill(template, values) {
      return Object.entries(values).reduce((text, [key, value]) => text.replaceAll(`{${key}}`, value), template);
    }

    function levelFor(minutes) {
      if (minutes === null || minutes === undefined) return null;
      let level = 0;
      while (level < LEVEL_THRESHOLDS.length && minutes > LEVEL_THRESHOLDS[level]) level += 1;
      return level;
    }

    function formatDuration(ms) {
      const totalMinutes = Math.max(0, Math.round(ms / 60000));
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      if (hours === 0) return `${minutes} ${clientCopy.minutes}`;
      if (minutes === 0) return `${hours} h`;
      return `${hours} h ${minutes} ${clientCopy.minutes}`;
    }

    // ---------------------------------------------------------------- rows

    function resetRow(row) {
      row.dataset.live = 'none';
      row.querySelector('.ride-row__stripe').dataset.level = 'idle';
      row.querySelector('[data-role="wait"]').textContent = '';
      row.querySelector('[data-role="wait"]').removeAttribute('data-level');
      row.querySelector('.ride-row__bar-fill').style.setProperty('--pct', '0');
    }

    function applyLive(row, entry, state) {
      const statusCell = row.querySelector('[data-role="status"]');
      const waitCell = row.querySelector('[data-role="wait"]');
      const stripe = row.querySelector('.ride-row__stripe');
      const barFill = row.querySelector('.ride-row__bar-fill');

      if (!entry) {
        resetRow(row);
        statusCell.textContent = '';
        return;
      }

      row.dataset.live = entry.isOpen ? 'open' : 'closed';
      row.dataset.wait = entry.waitTime === null ? '' : String(entry.waitTime);

      if (entry.isOpen && entry.waitTime !== null) {
        const level = levelFor(entry.waitTime);
        stripe.dataset.level = String(level);
        waitCell.dataset.level = String(level);
        waitCell.innerHTML = `<strong>${entry.waitTime}</strong><span>${clientCopy.minutes}</span>`;
        statusCell.textContent = clientCopy.levels[level];
        barFill.style.setProperty('--pct', String(Math.min(100, Math.round((entry.waitTime / BAR_SCALE_MAX) * 100))));
        return;
      }

      stripe.dataset.level = entry.isOpen ? 'unknown' : 'closed';
      waitCell.dataset.level = entry.isOpen ? 'unknown' : 'closed';
      waitCell.textContent = entry.isOpen ? clientCopy.openNow : '';
      barFill.style.setProperty('--pct', '0');

      // A per-ride cause is only meaningful while the park is running. Outside
      // opening hours the provider reports maintenance for most of the park,
      // which would otherwise be published as a factual claim.
      if (state !== 'OPEN') {
        statusCell.textContent = '';
        return;
      }
      statusCell.textContent = entry.status === 'DOWN'
        ? clientCopy.down
        : entry.status === 'REFURBISHMENT'
        ? clientCopy.refurbishment
        : entry.isOpen ? clientCopy.noWaitReported : clientCopy.closed;
    }

    function setScheduleHint(text) {
      for (const row of rows) {
        const statusCell = row.querySelector('[data-role="status"]');
        const waitCell = row.querySelector('[data-role="wait"]');
        resetRow(row);
        statusCell.textContent = '';
        waitCell.textContent = text || '';
        if (text) waitCell.dataset.level = 'soon';
      }
    }

    // ---------------------------------------------------------------- render

    function matchesFilter(row) {
      if (activeFilter === 'favorites') return favorites.has(row.dataset.slug);
      if (activeFilter === 'open') return row.dataset.live === 'open';
      if (activeFilter === 'quick') {
        const wait = row.dataset.wait;
        return row.dataset.live === 'open' && wait !== '' && wait !== undefined && Number(wait) <= 15;
      }
      return true;
    }

    function counts() {
      return {
        all: rows.length,
        open: rows.filter((row) => row.dataset.live === 'open').length,
        quick: rows.filter((row) => row.dataset.live === 'open' && row.dataset.wait !== '' && row.dataset.wait !== undefined && Number(row.dataset.wait) <= 15).length,
        favorites: favorites.size,
      };
    }

    function render() {
      const query = search.value.trim().toLocaleLowerCase(locale);
      let visible = 0;

      for (const row of rows) {
        const haystack = searchIndex[row.dataset.slug] || '';
        const show = (!query || haystack.includes(query)) && matchesFilter(row);
        row.hidden = !show;
        if (show) visible += 1;

        const favButton = row.querySelector('[data-role="fav"]');
        const isFav = favorites.has(row.dataset.slug);
        favButton.hidden = false;
        favButton.setAttribute('aria-pressed', String(isFav));
        favButton.setAttribute(
          'aria-label',
          fill(isFav ? clientCopy.favoriteRemove : clientCopy.favoriteAdd, { name: row.querySelector('.ride-row__name').textContent }),
        );
      }

      applySort();

      for (const group of groups) {
        const groupRows = [...group.querySelectorAll('.ride-row')];
        const shown = groupRows.filter((row) => !row.hidden);
        group.hidden = shown.length === 0;
        const meta = group.querySelector('[data-land-meta]');
        const openRows = shown.filter((row) => row.dataset.live === 'open');
        const waits = openRows.map((row) => Number(row.dataset.wait)).filter((value) => Number.isFinite(value));
        meta.textContent = parkState === 'OPEN' && openRows.length > 0
          ? fill(clientCopy.groupSummary, {
              open: String(openRows.length),
              avg: String(Math.round(waits.reduce((sum, value) => sum + value, 0) / (waits.length || 1))),
            })
          : '';
      }

      const total = counts();
      for (const button of filterButtons) {
        const badge = button.querySelector('.filter-count');
        if (badge) badge.textContent = String(total[button.dataset.filter] ?? 0);
        button.disabled = button.dataset.filter !== 'all' && total[button.dataset.filter] === 0;
      }

      resultCount.textContent = fill(clientCopy.results, { count: String(visible) });
      emptyMessage.hidden = visible > 0;
      favoritesNote.hidden = favorites.size === 0 && activeFilter !== 'favorites';
    }

    function applySort() {
      const mode = sortSelect.value;
      if (mode === 'land') {
        for (const group of groups) {
          const list = group.querySelector('.ride-rows');
          const sorted = [...group.querySelectorAll('.ride-row')].sort(byWaitThenName(mode));
          for (const row of sorted) list.append(row);
        }
        directory.dataset.flat = 'false';
        return;
      }
      // Flat modes collapse the groups into the first list so a global order is
      // actually global rather than per themed area.
      const first = groups[0]?.querySelector('.ride-rows');
      if (!first) return;
      const sorted = rows.slice().sort(byWaitThenName(mode));
      for (const row of sorted) first.append(row);
      directory.dataset.flat = 'true';
    }

    function byWaitThenName(mode) {
      return (a, b) => {
        const nameA = a.querySelector('.ride-row__name').textContent;
        const nameB = b.querySelector('.ride-row__name').textContent;
        if (mode === 'name') return nameA.localeCompare(nameB, locale);
        const openA = a.dataset.live === 'open';
        const openB = b.dataset.live === 'open';
        if (openA !== openB) return openA ? -1 : 1;
        const waitA = a.dataset.wait === '' || a.dataset.wait === undefined ? null : Number(a.dataset.wait);
        const waitB = b.dataset.wait === '' || b.dataset.wait === undefined ? null : Number(b.dataset.wait);
        if (mode === 'shortest') {
          return (waitA ?? Number.POSITIVE_INFINITY) - (waitB ?? Number.POSITIVE_INFINITY) || nameA.localeCompare(nameB, locale);
        }
        if (mode === 'longest') {
          return (waitB ?? -1) - (waitA ?? -1) || nameA.localeCompare(nameB, locale);
        }
        return nameA.localeCompare(nameB, locale);
      };
    }

    function renderShortest() {
      shortestList.replaceChildren();
      if (parkState !== 'OPEN') {
        shortest.hidden = true;
        return;
      }
      /*
       * Restricted to the headliners on purpose. Ranking all 36 rides by queue
       * length surfaces whatever nobody wants to ride — a VR upcharge at zero
       * minutes is not an answer to "where do I go now". The question worth
       * answering is which of the big attractions is reachable right now.
       */
      const candidates = rows
        .filter((row) => headlinerSlugs.includes(row.dataset.slug))
        .filter((row) => row.dataset.live === 'open' && row.dataset.wait !== '' && row.dataset.wait !== undefined)
        .sort((a, b) => Number(a.dataset.wait) - Number(b.dataset.wait))
        .slice(0, 3);
      if (candidates.length === 0) {
        shortest.hidden = true;
        return;
      }
      for (const row of candidates) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${row.id}`;
        link.className = 'shortest__card';
        const minutes = Number(row.dataset.wait);
        link.innerHTML =
          `<span class="shortest__wait" data-level="${levelFor(minutes)}"><strong>${minutes}</strong><span>${clientCopy.minutes}</span></span>` +
          `<span class="shortest__name"></span>`;
        link.querySelector('.shortest__name').textContent = row.querySelector('.ride-row__name').textContent;
        item.append(link);
        shortestList.append(item);
      }
      shortest.hidden = false;
    }

    function renderSchedule(data) {
      schedule.replaceChildren();
      const upcoming = (data.upcoming || []).filter((day) => day.openingTime);
      if (data.state === 'OPEN' || upcoming.length === 0) {
        schedule.hidden = true;
        return;
      }
      for (const day of upcoming.slice(0, 5)) {
        const card = document.createElement('div');
        card.className = 'schedule-day';
        const date = document.createElement('p');
        date.className = 'schedule-day__date';
        date.textContent = dayFormat.format(new Date(day.openingTime));
        const hours = document.createElement('p');
        hours.className = 'schedule-day__hours';
        hours.textContent = day.closingTime
          ? `${timeFormat.format(new Date(day.openingTime))} – ${timeFormat.format(new Date(day.closingTime))}`
          : timeFormat.format(new Date(day.openingTime));
        card.append(date, hours);
        if (day.crowdPercent !== null && day.crowdPercent !== undefined) {
          const crowd = document.createElement('p');
          crowd.className = 'schedule-day__crowd';
          crowd.textContent = `${day.crowdPercent} %`;
          card.append(crowd);
        }
        schedule.append(card);
      }
      schedule.hidden = false;
    }

    function renderBand(data) {
      const state = data.state;
      band.dataset.state = state;
      band.dataset.quality = data.dataQuality;

      const opensAt = data.today?.openingTime || data.next?.openingTime;
      const metaParts = [];

      if (state === 'OPEN') {
        bandText.textContent = data.dataQuality === 'stale' ? clientCopy.stale : clientCopy.live;
        if (data.today?.closingTime) metaParts.push(fill(clientCopy.closesAt, { time: timeFormat.format(new Date(data.today.closingTime)) }));
      } else if (state === 'OPENING_SOON' && data.opensInMs !== null) {
        bandText.textContent = fill(clientCopy.stateOpensIn, { duration: formatDuration(data.opensInMs) });
      } else if (state === 'BEFORE_OPEN' && opensAt) {
        bandText.textContent = fill(clientCopy.stateOpensToday, { time: timeFormat.format(new Date(opensAt)) });
      } else if (state === 'AFTER_CLOSE') {
        bandText.textContent = clientCopy.stateAfterClose;
      } else if (state === 'CLOSED_TODAY') {
        bandText.textContent = clientCopy.stateClosedToday;
      } else {
        bandText.textContent = clientCopy.stateSeasonBreak;
      }

      if (state !== 'OPEN' && data.next?.openingTime) {
        metaParts.push(fill(clientCopy.stateNextDay, {
          date: dayFormat.format(new Date(data.next.openingTime)),
          time: timeFormat.format(new Date(data.next.openingTime)),
        }));
      }
      if (data.today?.crowdPercent !== null && data.today?.crowdPercent !== undefined) {
        metaParts.push(`${clientCopy.crowdToday} ${data.today.crowdPercent} %`);
      }
      if (state === 'OPEN' && data.waitTimes?.updatedAt) {
        metaParts.push(`${clientCopy.updated} ${timeFormat.format(new Date(data.waitTimes.updatedAt))}`);
      }
      bandMeta.textContent = metaParts.join(' · ');

      // Only OPENING_SOON needs a ticking countdown; everything else is static.
      if (countdownTimer) window.clearInterval(countdownTimer);
      countdownTimer = null;
      if (state === 'OPENING_SOON' && data.opensInMs !== null) {
        let remaining = data.opensInMs;
        countdownTimer = window.setInterval(() => {
          remaining -= 60000;
          if (remaining <= 0) {
            window.clearInterval(countdownTimer);
            load();
            return;
          }
          bandText.textContent = fill(clientCopy.stateOpensIn, { duration: formatDuration(remaining) });
        }, 60000);
      }
    }

    function renderNotice(data) {
      if (data.dataQuality === 'unreliable') {
        noticeTitle.textContent = clientCopy.unreliableTitle;
        noticeText.textContent = ` ${clientCopy.unreliableText}`;
        notice.dataset.tone = 'warn';
        notice.hidden = false;
        return;
      }
      if (data.state === 'SEASON_BREAK') {
        noticeTitle.textContent = clientCopy.stateSeasonBreak;
        noticeText.textContent = ` ${clientCopy.seasonBreakText}`;
        notice.dataset.tone = 'info';
        notice.hidden = false;
        return;
      }
      notice.hidden = true;
    }

    function apply(data) {
      parkState = data.state;
      const usable = data.state === 'OPEN' && data.dataQuality !== 'unreliable' && data.waitTimes;

      liveBySlug = new Map();
      if (usable) {
        // Match on the provider name via the build-time search index keys.
        for (const entry of data.waitTimes.rides) {
          const row = rows.find((candidate) => (searchIndex[candidate.dataset.slug] || '').includes(entry.name.toLocaleLowerCase(locale)));
          if (row) liveBySlug.set(row.dataset.slug, entry);
        }
      }

      if (usable) {
        for (const row of rows) applyLive(row, liveBySlug.get(row.dataset.slug), data.state);
        const summary = data.waitTimes.summary;
        document.querySelector('#open-rides').textContent = String(summary.openRides);
        document.querySelector('#average-wait').textContent = summary.averageWait === null ? '—' : String(summary.averageWait);
        document.querySelector('#longest-wait').textContent = summary.longestWait === null ? '—' : String(summary.longestWait);
        document.querySelector('#average-wait-unit').hidden = summary.averageWait === null;
        document.querySelector('#longest-wait-unit').hidden = summary.longestWait === null;
        stats.hidden = false;
      } else {
        stats.hidden = true;
        const opensAt = data.today?.openingTime || data.next?.openingTime;
        const hint = opensAt && data.state !== 'SEASON_BREAK'
          ? fill(clientCopy.opensAtShort, { time: timeFormat.format(new Date(opensAt)) })
          : '';
        setScheduleHint(hint);
      }

      renderBand(data);
      renderNotice(data);
      renderSchedule(data);
      renderShortest();
      render();
    }

    function showError() {
      band.dataset.state = 'error';
      bandText.textContent = clientCopy.errorTitle;
      bandMeta.textContent = clientCopy.errorText;
      stats.hidden = true;
      schedule.hidden = true;
      shortest.hidden = true;
      // The directory stays. An unreachable provider must not blank the page.
      setScheduleHint('');
      render();
    }

    let lastUpdatedAt = null;

    async function load() {
      refreshButton.disabled = true;
      try {
        const response = await fetch('/api/park-now', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        lastUpdatedAt = data.waitTimes?.updatedAt || data.now;
        apply(data);
      } catch {
        showError();
      } finally {
        refreshButton.disabled = false;
      }
    }

    // The band wraps to a second line on narrow screens, so the themed-area
    // headings cannot assume a fixed offset for it.
    const syncBandHeight = () => {
      const height = `${Math.round(band.getBoundingClientRect().height)}px`;
      if (document.documentElement.style.getPropertyValue('--wait-band-height') !== height) {
        document.documentElement.style.setProperty('--wait-band-height', height);
      }
    };
    new ResizeObserver(syncBandHeight).observe(band);
    syncBandHeight();

    search.addEventListener('input', render);
    sortSelect.addEventListener('change', render);
    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter;
        for (const item of filterButtons) item.setAttribute('aria-pressed', String(item === button));
        render();
      });
    }
    directory.addEventListener('click', (event) => {
      const button = event.target.closest('[data-role="fav"]');
      if (!button) return;
      const slug = button.dataset.slug;
      if (favorites.has(slug)) favorites.delete(slug);
      else favorites.add(slug);
      writeFavorites();
      render();
    });
    refreshButton.addEventListener('click', load);

    // iOS Safari freezes timers in background tabs, so a five-minute interval
    // alone shows stale numbers under a "live" label after switching back.
    window.setInterval(() => {
      if (document.visibilityState === 'visible') load();
    }, 5 * 60 * 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible' || !lastUpdatedAt) return;
      if (Date.now() - new Date(lastUpdatedAt).getTime() > 5 * 60 * 1000) load();
    });
    window.addEventListener('online', load);

    render();
    load();
  </script>
</Layout>

<style is:global>
  /* ---------------------------------------------------------------- hero */
  .wait-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid var(--color-border-light);
    background: var(--color-bg-light);
  }
  .wait-hero__inner { position: relative; padding-block: 2rem 1.5rem; }
  .wait-hero__title {
    font-size: clamp(1.65rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .wait-hero__sub {
    margin-top: 0.65rem;
    max-width: 46ch;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* ------------------------------------------------------------ state band */
  .park-band {
    position: sticky;
    top: calc(var(--site-header-height, 4.25rem));
    z-index: 30;
    border-bottom: 2px solid var(--color-border);
    background: var(--color-surface);
  }
  /*
   * Two rows, not a wrapping flex line. Letting the refresh button wrap pushed
   * the band to ~120px on a phone — far too much for something that stays on
   * screen the whole time you scroll 36 rides.
   */
  .park-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    padding-block: 0.45rem;
  }
  .park-band__state {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .park-band__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-muted);
    flex: none;
  }
  .park-band__meta {
    grid-column: 1;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.35;
    min-width: 0;
  }
  .park-band__meta:empty { display: none; }
  .park-band__refresh {
    grid-column: 2;
    grid-row: 1 / -1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    flex: none;
  }
  .park-band__refresh:disabled { opacity: 0.5; cursor: progress; }

  .park-band[data-state="OPEN"] .park-band__dot { background: var(--color-available); }
  /* The pulse means live data, and only that. */
  .park-band[data-state="OPEN"][data-quality="fresh"] .park-band__dot { animation: park-pulse 2s ease-in-out infinite; }
  .park-band[data-state="OPENING_SOON"] .park-band__dot { background: var(--color-accent); }
  .park-band[data-state="error"] .park-band__dot,
  .park-band[data-quality="unreliable"] .park-band__dot { background: var(--color-gold); }

  @keyframes park-pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) {
    .park-band[data-state="OPEN"][data-quality="fresh"] .park-band__dot { animation: none; }
  }

  /* ---------------------------------------------------------------- stats */
  .wait-stats-section { padding-block: 1rem; }
  .wait-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .stat {
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: 0.7rem 0.85rem;
  }
  .stat__label { color: var(--color-muted); font-size: 0.75rem; font-weight: 700; }
  .stat__value { display: flex; align-items: baseline; gap: 0.35rem; margin-top: 0.15rem; }
  .stat__value strong { font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .stat__unit { color: var(--color-text-secondary); font-size: 0.8rem; }

  .wait-schedule {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(7.5rem, 1fr);
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.35rem;
  }
  .schedule-day {
    border: 2px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 0.6rem 0.7rem;
  }
  .schedule-day__date { font-weight: 700; font-size: 0.85rem; }
  .schedule-day__hours { color: var(--color-text-secondary); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .schedule-day__crowd { color: var(--color-muted); font-size: 0.78rem; font-weight: 700; }

  /* -------------------------------------------------------------- notices */
  .wait-list-section { padding-block: 1rem 3rem; }
  .wait-notice {
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-lg);
    background: #fffbeb;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .wait-notice[data-tone="info"] { border-color: var(--color-border-light); background: var(--color-surface-light); }
  .wait-notice strong { color: var(--color-text-primary); }

  /* ------------------------------------------------------- shortest right now */
  .shortest { margin-bottom: 1.1rem; }
  .shortest__title { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 0.5rem; }
  .shortest__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(9rem, 1fr);
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    padding: 0 0 0.35rem;
    margin: 0;
  }
  .shortest__card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: 0.6rem 0.75rem;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .shortest__wait { display: flex; align-items: baseline; gap: 0.15rem; font-variant-numeric: tabular-nums; }
  .shortest__wait strong { font-size: 1.35rem; }
  .shortest__wait span { font-size: 0.7rem; }
  .shortest__name { font-size: 0.85rem; font-weight: 700; line-height: 1.2; }

  /* -------------------------------------------------------------- toolbar */
  /*
   * Deliberately not sticky. On a phone this is three stacked controls; pinning
   * it would eat a third of the viewport for something you set once. The state
   * band and the themed-area headings are what you need while scrolling.
   */
  .wait-toolbar {
    display: grid;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 3px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-2);
    padding: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .wait-toolbar__label { display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.35rem; }
  .wait-toolbar input[type="search"],
  .wait-toolbar select {
    width: 100%;
    border: 3px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    padding: 0.6rem 0.85rem;
    font-size: 1rem;
  }
  .wait-toolbar input[type="search"]:focus,
  .wait-toolbar select:focus { border-color: var(--color-accent); outline: none; }
  .wait-toolbar__filters { border: 0; padding: 0; margin: 0; min-width: 0; }

  /*
   * The filter group used to clip its own focus ring: rounded corners plus
   * overflow:hidden on the container removed the 3px ring of the first button
   * entirely (WCAG 2.4.7). The radii now live on the buttons.
   */
  .filter-group {
    display: flex;
    gap: 0;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
  }
  .filter-group::-webkit-scrollbar { display: none; }
  .filter-group button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border-light);
    color: var(--color-text-secondary);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.6rem 0.8rem;
    min-height: 2.75rem;
    white-space: nowrap;
  }
  .filter-group button + button { border-inline-start-width: 0; }
  .filter-group button:first-child { border-start-start-radius: 0.75rem; border-end-start-radius: 0.75rem; }
  .filter-group button:last-child { border-start-end-radius: 0.75rem; border-end-end-radius: 0.75rem; }
  .filter-group button[aria-pressed="true"] { background: var(--color-accent); border-color: var(--color-accent); color: white; }
  .filter-group button:disabled { opacity: 0.45; cursor: not-allowed; }
  .filter-count { font-variant-numeric: tabular-nums; opacity: 0.75; }

  .wait-list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .wait-list-head h2 { font-size: 1.35rem; font-weight: 700; }
  .wait-list-head__desc { color: var(--color-text-secondary); font-size: 0.9rem; margin-top: 0.15rem; max-width: 52ch; }
  .wait-list-head__count { font-size: 0.85rem; font-weight: 700; color: var(--color-muted); font-variant-numeric: tabular-nums; }

  /* ------------------------------------------------------------- the list */
  /*
   * One frame around the whole directory rather than 36 heavy frames — the
   * neo-brutalist signature stays, the zebra of identical boxes goes.
   */
  .ride-directory {
    border: 3px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-1);
    background: var(--color-surface);
    overflow: hidden;
  }
  .land-group[hidden] { display: none; }
  .land-group__head {
    position: sticky;
    /* Both offsets are measured at runtime: the header can grow a planner bar
       and the band wraps to two lines on narrow screens. Guessing either one
       puts the heading underneath them. */
    top: calc(var(--site-header-height, 4.25rem) + var(--wait-band-height, 2.9rem));
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--color-surface-light);
    border-block: 1px solid var(--color-border-light);
    padding: 0.5rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .land-group:first-child .land-group__head { border-block-start: 0; }
  .land-group__meta { color: var(--color-muted); font-weight: 700; letter-spacing: 0; text-transform: none; font-variant-numeric: tabular-nums; }
  .ride-directory[data-flat="true"] .land-group__head { display: none; }

  .ride-rows { list-style: none; margin: 0; padding: 0; }

  .ride-row {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr) auto 2.75rem;
    align-items: center;
    gap: 0 0.7rem;
    min-height: 4rem;
    padding-inline-end: 0.35rem;
    border-block-end: 1px solid var(--color-border-light);
    content-visibility: auto;
    contain-intrinsic-size: 0 4rem;
  }
  .ride-rows > .ride-row:last-child { border-block-end: 0; }
  .ride-row[hidden] { display: none; }

  .ride-row__stripe { align-self: stretch; background: var(--color-border-light); }
  .ride-row__stripe[data-level="0"] { background: #15803D; }
  .ride-row__stripe[data-level="1"] { background: #4D7C0F; }
  .ride-row__stripe[data-level="2"] { background: #B45309; }
  .ride-row__stripe[data-level="3"] { background: #C2410C; }
  .ride-row__stripe[data-level="4"] { background: #BE185D; }
  .ride-row__stripe[data-level="unknown"] { background: #6B5E8C; }
  .ride-row__stripe[data-level="closed"],
  .ride-row__stripe[data-level="idle"] { background: var(--color-border-light); }

  .ride-row__body { display: grid; gap: 0.15rem; padding-block: 0.55rem; min-width: 0; }
  .ride-row__name { font-weight: 700; font-size: 0.98rem; line-height: 1.25; }
  .ride-row__meta { color: var(--color-muted); font-size: 0.78rem; min-height: 1em; }
  .ride-row__bar { display: block; height: 5px; border-radius: var(--radius-pill); background: var(--color-border-light); overflow: hidden; }
  .ride-row__bar-fill {
    display: block;
    height: 100%;
    width: calc(var(--pct, 0) * 1%);
    background: currentColor;
    color: var(--color-muted);
    transition: width var(--dur-2, 200ms) var(--ease-out, ease);
  }
  .ride-row:has(.ride-row__stripe[data-level="0"]) .ride-row__bar-fill { color: #15803D; }
  .ride-row:has(.ride-row__stripe[data-level="1"]) .ride-row__bar-fill { color: #4D7C0F; }
  .ride-row:has(.ride-row__stripe[data-level="2"]) .ride-row__bar-fill { color: #B45309; }
  .ride-row:has(.ride-row__stripe[data-level="3"]) .ride-row__bar-fill { color: #C2410C; }
  .ride-row:has(.ride-row__stripe[data-level="4"]) .ride-row__bar-fill {
    color: #BE185D;
    /* A fourth, non-colour cue for the top band; survives forced-colors. */
    background-image: repeating-linear-gradient(45deg, rgb(255 255 255 / 45%) 0 3px, transparent 3px 7px);
  }

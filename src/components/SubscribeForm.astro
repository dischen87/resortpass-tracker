---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
const kicker = tr('subscribe.kicker');
const benefits = [
  tr('subscribe.benefit_free'),
  tr('subscribe.benefit_availability'),
  tr('subscribe.benefit_privacy'),
];
---

<section class="border-y-[3px] border-border bg-white py-16 md:py-20" id="benachrichtigung">
  <div class="section-shell">
    <div class="mx-auto grid max-w-4xl items-start gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-x-14 lg:gap-y-6">
      <div class="lg:col-start-1 lg:row-start-1 reveal">
        <p class="section-kicker mb-3 inline-flex items-center gap-2">
          <Icon name="tabler:bell-ringing" class="h-5 w-5" aria-hidden="true" />
          {kicker}
        </p>
        <h2 class="section-heading mb-4">{tr('subscribe.title')}</h2>
        <p class="max-w-xl text-text-secondary leading-relaxed">{tr('subscribe.desc')}</p>
      </div>

      <div class="subscribe-card p-5 sm:p-7 lg:col-start-2 lg:row-span-2 lg:row-start-1 reveal">
        <form id="subscribe-form" class="space-y-5">
          <div>
            <label for="email" class="mb-2 block text-sm font-bold text-text-primary">{tr('subscribe.email_label')}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={tr('subscribe.email_placeholder')}
              autocomplete="email"
              class="min-h-13 w-full cursor-text rounded-xl border-[3px] border-border bg-bg px-4 py-3.5 text-base text-text-primary placeholder:text-muted focus:border-accent focus:outline-none focus:ring-0"
            />
          </div>

          <fieldset class="space-y-3">
            <legend class="text-sm text-text-secondary mb-2 font-bold">{tr('subscribe.notify_for')}</legend>
            <label class="pass-option group flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border-2 border-border-light bg-bg-light px-3 py-2">
              <input
                type="checkbox"
                name="silver"
                value="1"
                checked
                class="h-5 w-5 rounded border-2 border-border bg-bg text-accent focus:ring-accent/20 cursor-pointer"
              />
              <span class="flex items-center gap-2 text-sm font-bold text-text-secondary group-hover:text-text-primary">
                <Icon name="tabler:ticket" class="h-4 w-4 text-accent" aria-hidden="true" />
                <span>ResortPass Silver · 275 €+</span>
              </span>
            </label>
            <label class="pass-option pass-option-gold group flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border-2 border-border-light bg-amber-50 px-3 py-2">
              <input
                type="checkbox"
                name="gold"
                value="1"
                checked
                class="h-5 w-5 rounded border-2 border-border bg-bg text-accent focus:ring-accent/20 cursor-pointer"
              />
              <span class="flex items-center gap-2 text-sm font-bold text-text-secondary group-hover:text-text-primary">
                <Icon name="tabler:crown" class="h-4 w-4 text-gold" aria-hidden="true" />
                <span>ResortPass Gold · 430 €+</span>
              </span>
            </label>
          </fieldset>

          <button
            type="submit"
            class="btn-primary w-full cursor-pointer py-4 disabled:cursor-wait disabled:opacity-70"
          >
            <span class="btn-label inline-flex items-center gap-2">{tr('subscribe.submit')}</span>
          </button>

          <div id="form-message" class="form-message hidden items-center justify-center gap-2 rounded-xl border-2 px-4 py-3 text-center text-sm font-bold" role="status" aria-live="polite"></div>
        </form>

        <div id="subscribe-success" class="subscribe-success hidden text-center" tabindex="-1">
          <span class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-available">
            <Icon name="tabler:check" class="h-8 w-8" aria-hidden="true" />
          </span>
          <h3 class="section-heading mb-2 text-xl">{tr('subscribe.success_title')}</h3>
          <p class="mx-auto max-w-sm text-sm leading-relaxed text-text-secondary">{tr('subscribe.success')}</p>
        </div>

        <p class="mt-5 flex items-start justify-center gap-1.5 text-center text-xs leading-relaxed text-muted">
          <Icon name="tabler:lock" class="mt-0.5 h-3.5 w-3.5 shrink-0" aria-hidden="true" />
          <span>{tr('subscribe.privacy')}</span>
        </p>
      </div>

      <ul class="space-y-3 lg:col-start-1 lg:row-start-2 reveal">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3 text-sm font-bold text-text-secondary">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-100 text-available">
              <Icon name="tabler:check" class="h-4 w-4" aria-hidden="true" />
            </span>
            <span class="pt-0.5">{benefit}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script define:vars={{ lang }}>
  window.__subscribeFormLang = lang;
</script>

<script>
  import { getTranslation, type Lang } from '../i18n/translations';

  const formLang = (window as any).__subscribeFormLang as Lang || 'de';
  const tr = (key: string) => getTranslation(formLang, key);
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const msgEl = document.getElementById('form-message') as HTMLDivElement;
  const successPanel = document.getElementById('subscribe-success') as HTMLDivElement;

  function setButtonLoading(btn: HTMLButtonElement, loading: boolean) {
    const label = btn.querySelector('.btn-label') as HTMLElement;
    if (loading) {
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      label.innerHTML = `<span class="spinner" aria-hidden="true"></span>${tr('subscribe.sending')}`;
    } else {
      btn.disabled = false;
      btn.removeAttribute('aria-busy');
      label.textContent = tr('subscribe.submit');
    }
  }

  function showMessage(text: string, isError: boolean) {
    msgEl.textContent = text;
    msgEl.dataset.variant = isError ? 'error' : 'success';
    msgEl.setAttribute('role', isError ? 'alert' : 'status');
    msgEl.setAttribute('aria-live', isError ? 'assertive' : 'polite');
    msgEl.classList.remove('hidden');
    msgEl.classList.add('flex');
    // restart the enter/shake animation
    msgEl.style.animation = 'none';
    void msgEl.offsetWidth;
    msgEl.style.animation = '';
  }

  function confettiBurst() {
    if (prefersReduce) return;
    const colors = ['#7C3AED', '#EC4899', '#FACC15'];
    const canvas = document.createElement('canvas');
    canvas.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999';
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    document.body.appendChild(canvas);
    const ctx = canvas.getContext('2d')!;
    const rect = successPanel.getBoundingClientRect();
    const ox = rect.left + rect.width / 2;
    const oy = rect.top + rect.height / 2;
    const parts = Array.from({ length: 90 }, () => ({
      x: ox, y: oy,
      vx: (Math.random() - 0.5) * 14,
      vy: Math.random() * -13 - 4,
      size: Math.random() * 6 + 4,
      color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * Math.PI,
      vr: (Math.random() - 0.5) * 0.35,
      life: 1,
    }));
    let frame = 0;
    const tick = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of parts) {
        p.vy += 0.32;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        p.life -= 0.011;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(p.life, 0);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
      }
      frame++;
      if (frame < 150) requestAnimationFrame(tick);
      else canvas.remove();
    };
    requestAnimationFrame(tick);
  }

  function showSuccess() {
    form.classList.add('hidden');
    successPanel.classList.remove('hidden');
    successPanel.focus();
    confettiBurst();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    msgEl.classList.add('hidden');

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const silver = formData.get('silver') === '1';
    const gold = formData.get('gold') === '1';

    if (!silver && !gold) {
      showMessage(tr('subscribe.select_one'), true);
      return;
    }

    setButtonLoading(btn, true);

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, notify_silver: silver, notify_gold: gold, lang: formLang }),
      });

      const data = await res.json();

      if (res.ok) {
        showSuccess();
        return;
      }
      showMessage(data.error || tr('subscribe.error'), true);
    } catch {
      showMessage(tr('subscribe.error'), true);
    }

    setButtonLoading(btn, false);
  });
</script>

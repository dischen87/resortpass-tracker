---
import { type Lang, defaultLang, languages, langNames, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
  paths?: Partial<Record<Lang, string>>;
}

const lang = Astro.props.lang || defaultLang;
const paths = Astro.props.paths;
const languageLabel = getTranslation(lang, 'nav.language');

function getPathForLang(targetLang: Lang): string {
  if (paths?.[targetLang]) return paths[targetLang];
  const path = Astro.url.pathname;
  let cleanPath = path;
  for (const l of languages) {
    if (l !== defaultLang && (path.startsWith(`/${l}/`) || path === `/${l}`)) {
      cleanPath = path.slice(l.length + 1) || '/';
      break;
    }
  }
  if (!cleanPath.endsWith('/')) cleanPath += '/';
  if (targetLang === defaultLang) return cleanPath;
  return `/${targetLang}${cleanPath}`;
}
---

<nav aria-label={languageLabel} class="flex flex-wrap items-center gap-1">
  {languages.map((l) => (
    <a
      href={getPathForLang(l)}
      class:list={[
        'inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide transition-colors cursor-pointer',
        l === lang
          ? 'bg-bg-light text-accent border-2 border-accent'
          : 'text-muted hover:text-text-primary hover:bg-bg border-2 border-transparent',
      ]}
      aria-current={l === lang ? 'page' : undefined}
      aria-label={langNames[l]}
    >
      {l.toUpperCase()}
    </a>
  ))}
</nav>

---
import {
  defaultLocale,
  getLocaleDefinition,
  type LocaleCode,
} from '../i18n/locales';
import {
  resolveRouteAlternates,
  type RouteKey,
  type RoutePaths,
} from '../i18n/routes';
import { getTranslation } from '../i18n/translations';

interface Props {
  lang?: LocaleCode;
  /** Semantic route identifier. Usually inferred from the current pathname. */
  routeKey?: RouteKey;
  /** Explicitly published localized paths; retained for backwards compatibility. */
  paths?: RoutePaths;
  label?: string;
}

const lang = Astro.props.lang || defaultLocale;
const languageLabel = Astro.props.label || getTranslation(lang, 'nav.language');
const { alternates } = resolveRouteAlternates({
  pathname: Astro.url.pathname,
  routeKey: Astro.props.routeKey,
  explicitPaths: Astro.props.paths,
});
---

{alternates.length > 1 && (
  <nav aria-label={languageLabel} class="flex flex-wrap items-center gap-1" dir="ltr">
    {alternates.map(({ locale, path }) => (
      <a
        href={path}
        class:list={[
          'inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide transition-colors cursor-pointer',
          locale === lang
            ? 'bg-bg-light text-accent border-2 border-accent'
            : 'text-muted hover:text-text-primary hover:bg-bg border-2 border-transparent',
        ]}
        aria-current={locale === lang ? 'page' : undefined}
        aria-label={getLocaleDefinition(locale).nativeName}
        lang={getLocaleDefinition(locale).bcp47}
      >
        {locale.toUpperCase()}
      </a>
    ))}
  </nav>
)}

---
import { licensedMedia, type LicensedMediaEntry, type LicensedMediaId } from '../data/media';
import { getExperienceCopy } from '../i18n/experience';
import type { LocaleCode } from '../i18n/locales';

interface Props {
  mediaId: LicensedMediaId;
  alt: string;
  lang?: LocaleCode;
  class?: string;
  eager?: boolean;
  sizes?: string;
  /** A presentation crop; the attribution discloses it automatically. */
  aspectRatio?: string;
  objectPosition?: string;
  caption?: string;
}

const {
  mediaId,
  alt,
  lang = 'de',
  class: className,
  eager = false,
  sizes = '(max-width: 767px) calc(100vw - 2rem), 44rem',
  aspectRatio,
  objectPosition = 'center',
  caption,
} = Astro.props;

const media: LicensedMediaEntry | undefined = licensedMedia.find((entry) => entry.id === mediaId);
if (!media?.downloaded || !media.localPath) {
  throw new Error(`LicensedPhoto requires a downloaded, reviewed photo: ${mediaId}`);
}

const labels: Record<LocaleCode, { resized: string; cropped: string }> = {
  de: { resized: 'Bearbeitet: verkleinert, WebP.', cropped: 'Bearbeitet: zugeschnitten, verkleinert, WebP.' },
  en: { resized: 'Edited: resized, WebP.', cropped: 'Edited: cropped, resized, WebP.' },
  fr: { resized: 'Modifications : redimensionnement, WebP.', cropped: 'Modifications : recadrage, redimensionnement, WebP.' },
  it: { resized: 'Modifiche: ridimensionamento, WebP.', cropped: 'Modifiche: ritaglio, ridimensionamento, WebP.' },
  nl: { resized: 'Bewerkt: verkleind, WebP.', cropped: 'Bewerkt: bijgesneden, verkleind, WebP.' },
  es: { resized: 'Modificaciones: reducción de tamaño, WebP.', cropped: 'Modificaciones: recorte, reducción de tamaño, WebP.' },
  sv: { resized: 'Bearbetad: förminskad, WebP.', cropped: 'Bearbetad: beskuren, förminskad, WebP.' },
  ro: { resized: 'Modificări: redimensionare, WebP.', cropped: 'Modificări: decupare, redimensionare, WebP.' },
  cs: { resized: 'Úpravy: zmenšení, WebP.', cropped: 'Úpravy: ořez, zmenšení, WebP.' },
  pl: { resized: 'Zmiany: zmniejszenie rozmiaru, WebP.', cropped: 'Zmiany: kadrowanie, zmniejszenie rozmiaru, WebP.' },
  tr: { resized: 'Düzenleme: boyut küçültme, WebP.', cropped: 'Düzenleme: kırpma, boyut küçültme, WebP.' },
  da: { resized: 'Bearbejdet: formindsket, WebP.', cropped: 'Bearbejdet: beskåret, formindsket, WebP.' },
  el: { resized: 'Αλλαγές: μείωση μεγέθους, WebP.', cropped: 'Αλλαγές: περικοπή, μείωση μεγέθους, WebP.' },
  pt: { resized: 'Alterações: redução de tamanho, WebP.', cropped: 'Alterações: recorte, redução de tamanho, WebP.' },
  nb: { resized: 'Bearbeidet: forminsket, WebP.', cropped: 'Bearbeidet: beskåret, forminsket, WebP.' },
  he: { resized: 'עריכה: הקטנה, WebP.', cropped: 'עריכה: חיתוך, הקטנה, WebP.' },
  hu: { resized: 'Módosítások: méretcsökkentés, WebP.', cropped: 'Módosítások: kivágás, méretcsökkentés, WebP.' },
};
const copy = labels[lang];
const photoLabel = getExperienceCopy(lang).photoLabel;
const isCropped = media.cropped || Boolean(aspectRatio);
const width = media.displayWidth ?? media.width;
const height = media.displayHeight ?? media.height;
const srcset = media.responsiveVariants?.map((variant) => `${variant.path} ${variant.width}w`).join(', ');
---

<figure class:list={['licensed-photo', className]}>
  <img
    src={media.localPath}
    {srcset}
    sizes={srcset ? sizes : undefined}
    {alt}
    {width}
    {height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'low'}
    decoding="async"
    style={aspectRatio ? `aspect-ratio: ${aspectRatio}; object-position: ${objectPosition};` : undefined}
  />
  <figcaption>
    {caption && <span class="licensed-photo-caption">{caption}</span>}
    <span class="licensed-photo-credit">
      {photoLabel}: <a href={media.filePageUrl} target="_blank" rel="noopener noreferrer"><bdi>{media.title}</bdi></a>
      {' · '}<bdi>{media.author}</bdi>{' · '}
      <a href={media.licenseUrl} target="_blank" rel="license noopener noreferrer"><bdi>CC BY-SA 4.0</bdi></a>
      {' · '}{isCropped ? copy.cropped : copy.resized}
    </span>
  </figcaption>
</figure>

<style>
  .licensed-photo {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .licensed-photo img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--color-surface-light);
  }

  .licensed-photo figcaption {
    display: grid;
    gap: .35rem;
    padding: .65rem .85rem .8rem;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .licensed-photo-caption {
    color: var(--color-text-primary);
    font-size: .8rem;
    font-weight: 600;
  }

  .licensed-photo-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: .15em;
  }

  .licensed-photo-credit a:hover {
    color: var(--color-text-primary);
  }

  .licensed-photo-credit a:focus-visible {
    outline: 2px solid var(--color-border);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 30rem) {
    .licensed-photo {
      border-radius: var(--radius-lg);
    }

    .licensed-photo figcaption {
      padding-inline: .7rem;
    }
  }
</style>

---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, crowdCalendarPaths, getTranslation } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
  showLanguageSwitcher?: boolean;
}

const lang = Astro.props.lang || defaultLang;
const showLanguageSwitcher = Astro.props.showLanguageSwitcher ?? true;
const tr = (key: string) => getTranslation(lang, key);
const homePath = lang === defaultLang ? '/' : `/${lang}/`;
const waitTimesPath = `${homePath}wartezeiten/`;
const crowdCalendarPath = crowdCalendarPaths[lang];
const isWaitTimesPage = Astro.url.pathname.endsWith('/wartezeiten/');
const isCrowdCalendarPage = Object.values(crowdCalendarPaths).includes(Astro.url.pathname as (typeof crowdCalendarPaths)[Lang]);
const menuLabel = { de: 'Menü', fr: 'Menu', it: 'Menu', en: 'Menu' }[lang];

const navItems = [
  { href: waitTimesPath, label: tr('nav.wait_times'), active: isWaitTimesPage },
  { href: crowdCalendarPath, label: tr('nav.crowd_short'), active: isCrowdCalendarPage },
  { href: `${homePath}#history`, label: tr('nav.history_short'), active: false },
  { href: `${homePath}#community`, label: 'Community', active: false },
];
---

<header class="sticky top-0 z-50 bg-bg/95 pb-2 pt-3 backdrop-blur-md">
  <div class="section-shell">
    <nav aria-label={tr('nav.main')} class="nav-card relative px-3 py-2.5 sm:px-5">
      <div class="flex min-h-12 items-center justify-between gap-2">
        <a href={homePath} aria-label="ResortPass Tracker" class="flex min-w-0 items-center gap-2.5 rounded-xl">
          <img src="/favicon.svg" alt="" width="44" height="44" class="h-10 w-10 shrink-0 sm:h-11 sm:w-11" />
          <span class="brand-wordmark truncate">resortpass<span>tracker</span></span>
        </a>

        <div class="hidden items-center gap-0.5 xl:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-bold transition-colors',
                item.active ? 'bg-accent/10 text-accent' : 'text-text-secondary hover:bg-bg-light hover:text-text-primary',
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="flex shrink-0 items-center gap-2">
          {showLanguageSwitcher && (
            <div class="hidden xl:block">
              <LanguageSwitcher lang={lang} paths={isCrowdCalendarPage ? crowdCalendarPaths : undefined} />
            </div>
          )}
          <a href={`${homePath}#benachrichtigung`} class="hidden min-h-11 items-center gap-1.5 rounded-full border-[3px] border-border bg-yellow px-5 py-2 font-heading text-sm font-extrabold text-text-primary shadow-[3px_3px_0_var(--color-border)] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-border)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none xl:inline-flex">
            <Icon name="tabler:bell-ringing" class="icon-bell h-4 w-4" aria-hidden="true" />
            {tr('nav.alert')}
          </a>
          <a
            href={`${homePath}#benachrichtigung`}
            class="flex h-11 w-11 items-center justify-center rounded-full border-[3px] border-border bg-yellow text-text-primary shadow-[3px_3px_0_var(--color-border)] transition active:translate-x-[2px] active:translate-y-[2px] active:shadow-none xl:hidden"
            aria-label={tr('subscribe.sticky_cta')}
          >
            <Icon name="tabler:bell-ringing" class="h-5 w-5" aria-hidden="true" />
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-[3px] border-border bg-white text-text-primary xl:hidden"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={menuLabel}
          >
            <Icon name="tabler:menu-2" class="menu-open-icon h-6 w-6" aria-hidden="true" />
            <Icon name="tabler:x" class="menu-close-icon hidden h-6 w-6" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="absolute left-0 right-0 top-[calc(100%+0.65rem)] hidden" hidden>
        <div class="nav-card bg-white p-3 shadow-[5px_5px_0_var(--color-pink)]">
          <div class="grid gap-1 sm:grid-cols-2">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class:list={[
                  'min-h-11 rounded-xl px-4 py-3 text-sm font-bold',
                  item.active ? 'bg-accent text-white' : 'bg-bg-light text-text-secondary hover:text-text-primary',
                ]}
              >
                {item.label}
              </a>
            ))}
          </div>
          {showLanguageSwitcher && (
            <div class="mt-3 border-t-2 border-border-light pt-3">
              <LanguageSwitcher lang={lang} paths={isCrowdCalendarPage ? crowdCalendarPaths : undefined} />
            </div>
          )}
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle?.querySelector('.menu-open-icon');
  const closeIcon = toggle?.querySelector('.menu-close-icon');

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (toggle?.getAttribute('aria-expanded') === 'true' && !toggle.closest('nav')?.contains(event.target as Node)) setMenuOpen(false);
  });
</script>

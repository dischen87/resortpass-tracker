---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2">
  <nav class="nav-card px-4 sm:px-6 py-3">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href={lang === defaultLang ? '/' : `/${lang}/`} class="flex items-center gap-2 group cursor-pointer">
        <div class="w-9 h-9 rounded-lg bg-accent border-2 border-border flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
      </a>

      <!-- Nav links (desktop) -->
      <div class="hidden md:flex items-center gap-1">
        <a href="#benachrichtigung" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg transition-all cursor-pointer">
          {tr('subscribe.sticky_cta')}
        </a>
        <a href="#info" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg transition-all cursor-pointer">
          Info
        </a>
        <a href="#history" class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text-primary rounded-lg hover:bg-bg transition-all cursor-pointer">
          {tr('history.title')}
        </a>
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <LanguageSwitcher lang={lang} />
        <a
          href="#benachrichtigung"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-bold bg-accent text-white rounded-lg border-2 border-border shadow-[2px_2px_0px_var(--color-border)] hover:shadow-[3px_3px_0px_var(--color-border)] hover:translate-x-[-1px] hover:translate-y-[-1px] active:shadow-none active:translate-x-[1px] active:translate-y-[1px] transition-all cursor-pointer"
        >
          Alert
        </a>
      </div>
    </div>
  </nav>
</div>

---
import type { Lang } from '../i18n/translations';
import SiteHeader from './SiteHeader.astro';

interface Props {
  lang?: Lang;
  showLanguageSwitcher?: boolean;
}

const lang = Astro.props.lang || 'de';
const showLanguageSwitcher = Astro.props.showLanguageSwitcher ?? true;
---

<SiteHeader lang={lang} showLanguageSwitcher={showLanguageSwitcher} />

---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
import { getTranslation, type Lang } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = (key: string) => getTranslation(lang, key);
const homePath = getRoutePath('home', lang)!;
---

<Layout lang={lang} routeKey="communityNew" title={tr('community.form_title')} noindex>
  <Navbar lang={lang} />
  <main id="main-content" class="min-h-[70vh] py-14 md:py-20">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <p class="section-kicker mb-2">Community</p>
        <h1 class="section-heading mb-3">{tr('community.form_title')}</h1>
        <p class="text-text-secondary">{tr('community.form_desc')}</p>
      </div>

      <div class="card p-6 md:p-8" style="--card-shadow:#C4B5FD">
        <form id="community-form" class="space-y-5">
          <div>
            <label for="author_name" class="block text-sm font-bold mb-1.5">{tr('community.name_label')}</label>
            <input type="text" id="author_name" name="author_name" required maxlength="50" autocomplete="name" placeholder={tr('community.name_placeholder')} class="min-h-12 w-full rounded-xl border-[3px] border-border bg-bg px-4 py-3 text-sm text-text-primary placeholder:text-muted focus:border-accent focus:outline-none" />
          </div>
          <div>
            <label for="community-title" class="block text-sm font-bold mb-1.5">{tr('community.title_label')}</label>
            <input type="text" id="community-title" name="title" required minlength="3" maxlength="100" placeholder={tr('community.title_placeholder')} class="min-h-12 w-full rounded-xl border-[3px] border-border bg-bg px-4 py-3 text-sm text-text-primary placeholder:text-muted focus:border-accent focus:outline-none" />
          </div>
          <div>
            <label for="community-body" class="block text-sm font-bold mb-1.5">{tr('community.body_label')}</label>
            <textarea id="community-body" name="body" required minlength="10" rows="5" maxlength="2000" placeholder={tr('community.body_placeholder')} class="w-full resize-y rounded-xl border-[3px] border-border bg-bg px-4 py-3 text-sm text-text-primary placeholder:text-muted focus:border-accent focus:outline-none"></textarea>
            <p class="text-xs text-muted mt-1"><span id="char-count">0</span>/2000</p>
          </div>
          <button type="submit" id="submit-btn" class="btn-primary w-full" data-label={tr('community.submit')} data-submitting={tr('community.submitting')}>
            {tr('community.submit')}
          </button>
        </form>

        <div id="form-success" class="hidden text-center py-6" role="status">
          <p class="text-lg font-bold mb-4">{tr('community.success')}</p>
          <a href={`${homePath}#community`} class="text-sm font-bold text-accent hover:underline">{tr('community.title')}</a>
        </div>

        <div id="form-error" class="hidden mt-4 p-3 rounded-xl bg-red-50 border-2 border-red-200 text-red-700 text-sm text-center" role="alert"></div>

        <div id="form-no-token" class="hidden text-center py-6" role="status">
          <p class="text-sm text-text-secondary">{tr('community.login_required')}</p>
          <a href={`${homePath}#benachrichtigung`} class="inline-flex mt-5 font-bold text-sm text-accent hover:underline">{tr('subscribe.sticky_cta')}</a>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} showLanguageSwitcher={false} />

  <script define:vars={{ lang }}>
    window.__communityFormLang = lang;
  </script>

  <script>
    import { getTranslation, type Lang } from '../i18n/translations';

    const lang = ((window as any).__communityFormLang || 'de') as Lang;
    const tr = (key: string) => getTranslation(lang, key);
    const token = new URLSearchParams(window.location.search).get('token');
    const form = document.getElementById('community-form') as HTMLFormElement;
    const noToken = document.getElementById('form-no-token')!;
    const success = document.getElementById('form-success')!;
    const error = document.getElementById('form-error')!;
    const submit = document.getElementById('submit-btn') as HTMLButtonElement;
    const body = document.getElementById('community-body') as HTMLTextAreaElement;

    if (!token) {
      form.classList.add('hidden');
      noToken.classList.remove('hidden');
    }

    body?.addEventListener('input', () => {
      document.getElementById('char-count')!.textContent = String(body.value.length);
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.classList.add('hidden');
      submit.disabled = true;
      submit.textContent = submit.dataset.submitting || tr('community.submitting');

      try {
        const response = await fetch('/api/community/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token,
            lang,
            author_name: (document.getElementById('author_name') as HTMLInputElement).value,
            title: (document.getElementById('community-title') as HTMLInputElement).value,
            body: body.value,
          }),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || tr('community.error'));
        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch (cause) {
        error.textContent = cause instanceof Error ? cause.message : tr('community.error');
        error.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = submit.dataset.label || tr('community.submit');
      }
    });
  </script>
</Layout>

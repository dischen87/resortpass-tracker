---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="py-16 md:py-20" id="info" aria-labelledby="info-heading">
  <div class="section-shell">
    <div class="text-center mb-9 md:mb-12">
      <h2 id="info-heading" class="section-heading mb-3">{tr('info.section_title')}</h2>
      <p class="text-text-secondary max-w-2xl mx-auto">{tr('info.section_desc')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      <article class="card reveal p-6" style="--card-shadow:#C4B5FD;--i:0">
        <p class="font-mono text-xs font-bold uppercase tracking-wider text-accent mb-3">01</p>
        <h3 class="text-lg font-bold mb-3">{tr('info.what_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.what_text')}</p>
      </article>

      <article class="card reveal p-6" style="--card-shadow:#FDE68A;--i:1">
        <p class="font-mono text-xs font-bold uppercase tracking-wider text-accent mb-3">02</p>
        <h3 class="text-lg font-bold mb-3">{tr('info.why_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.why_text')}</p>
      </article>

      <article class="card reveal p-6" style="--card-shadow:#F9A8D4;--i:2">
        <p class="font-mono text-xs font-bold uppercase tracking-wider text-accent mb-3">03</p>
        <h3 class="text-lg font-bold mb-3">{tr('info.how_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.how_text')}</p>
      </article>
    </div>

    <article class="card reveal p-6 md:p-8 mb-8 border-accent" style="--card-shadow:var(--color-accent)">
      <p class="text-xs font-bold uppercase tracking-wider text-accent mb-2">{tr('info.answer_label')}</p>
      <h3 class="text-xl md:text-2xl font-bold mb-3">{tr('info.tip_title')}</h3>
      <p class="text-text-secondary leading-relaxed">{tr('info.tip_text')}</p>
    </article>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <article class="card card-silver reveal p-6" style="--i:0">
        <div class="flex items-baseline justify-between gap-4 mb-3">
          <h3 class="text-lg font-bold text-silver-light">{tr('info.silver_title')}</h3>
          <span class="text-sm font-mono font-bold">325 / 275&nbsp;&euro;</span>
        </div>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.silver_desc')}</p>
      </article>

      <article class="card card-gold reveal p-6" style="--i:1">
        <div class="flex items-baseline justify-between gap-4 mb-3">
          <h3 class="text-lg font-bold text-gold-light">{tr('info.gold_title')}</h3>
          <span class="text-sm font-mono font-bold">495 / 430&nbsp;&euro;</span>
        </div>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.gold_desc')}</p>
      </article>
    </div>

    <p class="mt-5 text-center text-xs text-muted">
      {tr('info.source_note')}
      <a href="https://www.europapark.de/de/resortpass/faq" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-bold text-accent underline decoration-2 underline-offset-2">
        {tr('status.official_details')}
        <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="py-16 md:py-20" id="info">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="font-family: var(--font-heading);">Info</h2>
      <p class="text-text-secondary max-w-lg mx-auto">{tr('info.what_text').split('.')[0]}.</p>
    </div>

    <!-- Feature cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- What is ResortPass -->
      <div class="card rounded-2xl p-6 animate-fade-in-up">
        <div class="w-12 h-12 rounded-xl bg-accent/10 border-2 border-accent/30 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
        <h3 class="text-base font-bold mb-2" style="font-family: var(--font-heading);">{tr('info.what_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.what_text')}</p>
      </div>

      <!-- Why sold out -->
      <div class="card rounded-2xl p-6 animate-fade-in-up-delay-1">
        <div class="w-12 h-12 rounded-xl bg-red/10 border-2 border-red/30 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
          </svg>
        </div>
        <h3 class="text-base font-bold mb-2" style="font-family: var(--font-heading);">{tr('info.why_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.why_text')}</p>
      </div>

      <!-- How does tracker work -->
      <div class="card rounded-2xl p-6 animate-fade-in-up-delay-2">
        <div class="w-12 h-12 rounded-xl bg-available/10 border-2 border-available/30 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-available" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-base font-bold mb-2" style="font-family: var(--font-heading);">{tr('info.how_title')}</h3>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.how_text')}</p>
      </div>
    </div>

    <!-- Silver vs Gold comparison -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="card card-silver rounded-2xl p-6 animate-fade-in-up-delay-3">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-silver/15 border-2 border-silver/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-silver" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
          </div>
          <h3 class="font-bold text-silver-light" style="font-family: var(--font-heading);">{tr('info.silver_title')}</h3>
        </div>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.silver_desc')}</p>
        <div class="mt-4 text-sm text-muted font-mono font-bold">325&thinsp;&euro; / 275&thinsp;&euro;</div>
      </div>

      <div class="card card-gold rounded-2xl p-6 animate-fade-in-up-delay-3">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-gold/15 border-2 border-gold/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="font-bold text-gold-light" style="font-family: var(--font-heading);">{tr('info.gold_title')}</h3>
        </div>
        <p class="text-sm text-text-secondary leading-relaxed">{tr('info.gold_desc')}</p>
        <div class="mt-4 text-sm text-muted font-mono font-bold">495&thinsp;&euro; / 430&thinsp;&euro;</div>
      </div>
    </div>

    <!-- Tip card -->
    <div class="card rounded-2xl p-6 md:p-8 border-accent animate-fade-in-up" style="box-shadow: 4px 4px 0px var(--color-accent);">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-accent/10 border-2 border-accent/30 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold mb-2 text-accent" style="font-family: var(--font-heading);">{tr('info.tip_title')}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{tr('info.tip_text')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="py-16 md:py-20" id="news" aria-labelledby="news-heading">
  <div class="section-shell">
    <div class="max-w-3xl mx-auto reveal">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <p class="section-kicker mb-2">{tr('news.feed_label')}</p>
          <h2 id="news-heading" class="section-heading mb-2">{tr('news.title')}</h2>
          <p class="text-text-secondary">{tr('news.desc')}</p>
        </div>
        <a
          href={`/api/feed.xml?lang=${lang}`}
          class="btn-secondary shrink-0 text-sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="tabler:rss" class="h-4 w-4" aria-hidden="true" />
          {tr('news.rss')}
        </a>
      </div>

      <div id="news-feed" class="space-y-4" aria-live="polite" aria-busy="true">
        <div class="card rounded-2xl p-6 text-sm text-muted">{tr('status.loading')}</div>
      </div>

      <details open class="mt-6 rounded-2xl border-[3px] border-border bg-surface p-5 shadow-[4px_4px_0_#F9A8D4]">
        <summary class="min-h-11 cursor-pointer py-2 font-bold text-sm">{tr('news.incident_2026_03_19_title')} · {tr('news.incident_2026_03_19_badge')}</summary>
        <p class="mt-3 text-sm text-text-secondary leading-relaxed">{tr('news.incident_2026_03_19_text')}</p>
      </details>
    </div>
  </div>
</section>

<script define:vars={{ lang }}>
  window.__newsLang = lang;
</script>

<script>
  import { getTranslation, type Lang } from '../i18n/translations';
  import { getLocaleDefinition } from '../i18n/locales';

  const newsLang = ((window as any).__newsLang || 'de') as Lang;
  const tr = (key: string) => getTranslation(newsLang, key);
  const locale = getLocaleDefinition(newsLang).bcp47;

  type NewsItem = {
    title: string;
    summary: string;
    updatedAt: string;
    status: {
      silver: { state: 'available' | 'sold_out' | 'unknown' };
      gold: { state: 'available' | 'sold_out' | 'unknown' };
    };
  };

  function stateText(state: 'available' | 'sold_out' | 'unknown') {
    return state === 'available' ? tr('status.available') : state === 'sold_out' ? tr('status.sold_out') : tr('status.error');
  }

  const cardShadows = ['#C4B5FD', '#FDE68A', '#F9A8D4'];
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function makeItem(item: NewsItem, index: number) {
    const article = document.createElement('article');
    article.className = 'card p-5 md:p-6';
    article.style.setProperty('--card-shadow', cardShadows[index % cardShadows.length]);
    if (!prefersReduce) {
      article.style.animation = 'fade-in-up var(--dur-4) var(--ease-out) both';
      article.style.animationDelay = `${index * 70}ms`;
    }

    const date = new Date(item.updatedAt);
    const time = document.createElement('time');
    time.className = 'text-xs font-mono text-muted';
    time.dateTime = item.updatedAt;
    time.textContent = Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString(locale, { dateStyle: 'long' });

    const title = document.createElement('h3');
    title.className = 'text-lg font-bold mt-2 mb-2';
    title.textContent = item.title;

    const summary = document.createElement('p');
    summary.className = 'text-sm text-text-secondary leading-relaxed';
    summary.textContent = item.summary;

    const states = document.createElement('div');
    states.className = 'flex flex-wrap gap-2 mt-4';
    for (const [label, value] of [['Silver', item.status.silver], ['Gold', item.status.gold]] as const) {
      const badge = document.createElement('span');
      badge.className = `status-pill status-pill-${value.state}`;
      badge.textContent = `${label}: ${stateText(value.state)}`;
      states.append(badge);
    }

    article.append(time, title, summary, states);
    return article;
  }

  async function loadNews() {
    const container = document.getElementById('news-feed');
    if (!container) return;

    try {
      const response = await fetch(`/api/news?lang=${newsLang}`);
      if (!response.ok) throw new Error('feed');
      const data = await response.json();
      container.replaceChildren();
      const items = (data.items || []).slice(0, 3) as NewsItem[];
      if (!items.length) {
        const empty = document.createElement('p');
        empty.className = 'card rounded-2xl p-6 text-sm text-muted';
        empty.textContent = tr('news.empty');
        container.append(empty);
      } else {
        items.forEach((item, index) => container.append(makeItem(item, index)));
      }
    } catch {
      container.textContent = tr('news.empty');
      container.className = 'card rounded-2xl p-6 text-sm text-muted';
    } finally {
      container.setAttribute('aria-busy', 'false');
    }
  }

  loadNews();
</script>

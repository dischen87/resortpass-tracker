---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { getRoutePath } from '../i18n/routes';
import { getLocaleDefinition } from '../i18n/locales';
import { crowdCalendarPaths, getTranslation } from '../i18n/translations';
import { getOpeningHoursPack, type OpeningHoursLocale } from '../content/opening-hours';
import { ENTITY_IDS, SITE_URL } from '../data/entity-graph';
import '../styles/global.css';

interface Props {
  lang: OpeningHoursLocale;
}

const { lang } = Astro.props;
const pack = getOpeningHoursPack(lang);
const tr = (key: string) => getTranslation(lang, key);
const pagePath = getRoutePath('openingHours', lang)!;
const homePath = getRoutePath('home', lang)!;
const waitTimesPath = getRoutePath('waitTimes', lang)!;
const crowdPath = crowdCalendarPaths[lang];
const localeTag = getLocaleDefinition(lang).bcp47;

const officialUrls: Record<OpeningHoursLocale, string> = {
  de: 'https://www.europapark.de/de/freizeitpark/infos/oeffnungszeiten-preise',
  en: 'https://www.europapark.de/en/theme-park/info/opening-hours-prices',
  fr: 'https://www.europapark.de/fr/parc-de-loisirs/infos/horaires-douverture-tarifs',
  nl: 'https://www.europapark.de/nl/pretpark/info/openingstijden-prijzen',
  it: 'https://www.europapark.de/it/parco-divertimenti/info/orari-apertura-prezzi',
};

const clientCopy = {
  today: pack.todayLabel,
  closed: pack.closedLabel,
  crowd: pack.crowdLabel,
  noDataTitle: pack.noDataTitle,
  noDataText: pack.noDataText,
  updated: tr('wait.updated'),
};
---

<Layout lang={lang} routeKey="openingHours" title={pack.metaTitle} description={pack.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${SITE_URL}${pagePath}#webpage`,
        url: `${SITE_URL}${pagePath}`,
        name: pack.metaTitle,
        description: pack.metaDescription,
        inLanguage: localeTag,
        isPartOf: { '@id': ENTITY_IDS.website },
        about: { '@id': ENTITY_IDS.europaPark },
        publisher: { '@id': ENTITY_IDS.organization },
        breadcrumb: {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: tr('nav.home'), item: `${SITE_URL}${homePath}` },
            { '@type': 'ListItem', position: 2, name: pack.title, item: `${SITE_URL}${pagePath}` },
          ],
        },
      },
      {
        // The answers hold whether or not the live table renders, which is the
        // only reason this markup is worth anything to an answer engine.
        '@type': 'FAQPage',
        '@id': `${SITE_URL}${pagePath}#faq`,
        mainEntity: pack.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      },
    ],
  })} />

  <Navbar lang={lang} />

  <main id="main-content" class="hours">
    <div class="section-shell section-shell--narrow">
      <header class="hours__header">
        <p class="hours__eyebrow">{pack.eyebrow}</p>
        <h1>{pack.title}</h1>
        <p class="hours__intro">{pack.intro}</p>
      </header>

      <section aria-labelledby="hours-upcoming">
        <h2 id="hours-upcoming" class="hours__h2">{pack.upcomingTitle}</h2>
        <p class="hours__desc">{pack.upcomingDesc}</p>

        <p id="hours-loading" class="hours__loading">{pack.loadingLabel}</p>

        <div id="hours-empty" class="hours__empty" hidden>
          <strong>{pack.noDataTitle}</strong>
          <span>{pack.noDataText}</span>
        </div>

        <div id="hours-table-wrap" class="hours__tablewrap" hidden>
          <table class="hours__table">
            <thead>
              <tr>
                <th scope="col">{pack.eyebrow}</th>
                <th scope="col">{pack.hoursColumn}</th>
                <th scope="col">{pack.crowdLabel}</th>
              </tr>
            </thead>
            <tbody id="hours-rows"></tbody>
          </table>
        </div>

        <p id="hours-stamp" class="hours__stamp"></p>
      </section>

      <section class="hours__section" aria-labelledby="hours-faq">
        <h2 id="hours-faq" class="hours__h2">FAQ</h2>
        <div class="hours__faq">
          {pack.faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="hours__section">
        <p class="hours__source">{pack.sourceNote}</p>
        <p>
          <a href={officialUrls[lang]} target="_blank" rel="noopener noreferrer" class="hours__link">
            {pack.officialLinkLabel}
          </a>
        </p>
      </section>

      <section class="hours__section" aria-labelledby="hours-related">
        <h2 id="hours-related" class="hours__h2">{pack.relatedTitle}</h2>
        <div class="hours__related">
          <a href={waitTimesPath}>{pack.relatedWait}</a>
          <a href={crowdPath}>{pack.relatedCrowd}</a>
        </div>
      </section>
    </div>
  </main>

  <Footer lang={lang} />

  <script define:vars={{ localeTag, clientCopy }}>
    const dayFormat = new Intl.DateTimeFormat(localeTag, { weekday: 'long', day: '2-digit', month: 'long' });
    const timeFormat = new Intl.DateTimeFormat(localeTag, { hour: '2-digit', minute: '2-digit' });

    const loading = document.querySelector('#hours-loading');
    const empty = document.querySelector('#hours-empty');
    const wrap = document.querySelector('#hours-table-wrap');
    const rows = document.querySelector('#hours-rows');
    const stamp = document.querySelector('#hours-stamp');

    function cell(text, className) {
      const td = document.createElement('td');
      td.textContent = text;
      if (className) td.className = className;
      return td;
    }

    async function load() {
      try {
        const response = await fetch('/api/park-now', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        const data = await response.json();
        const days = (data.upcoming || []).filter((day) => day.openingTime);

        loading.hidden = true;
        if (days.length === 0) {
          empty.hidden = false;
          return;
        }

        const todayKey = data.today?.date;
        for (const day of days) {
          const tr = document.createElement('tr');
          const opens = new Date(day.openingTime);
          const label = dayFormat.format(opens);
          const isToday = day.date === todayKey;

          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = isToday ? `${clientCopy.today} · ${label}` : label;
          if (isToday) th.className = 'is-today';
          tr.append(th);

          tr.append(cell(
            day.closingTime
              ? `${timeFormat.format(opens)} – ${timeFormat.format(new Date(day.closingTime))}`
              : timeFormat.format(opens),
            'hours__time',
          ));
          tr.append(cell(
            day.crowdPercent === null || day.crowdPercent === undefined ? '—' : `${day.crowdPercent} %`,
            'hours__crowd',
          ));
          rows.append(tr);
        }
        wrap.hidden = false;
        if (data.now) stamp.textContent = `${clientCopy.updated} ${timeFormat.format(new Date(data.now))}`;
      } catch {
        // The evergreen answers below still carry the page; the table simply
        // reports that it has nothing rather than showing a broken shell.
        loading.hidden = true;
        empty.hidden = false;
      }
    }

    load();
  </script>
</Layout>

<style is:global>
  .hours { padding-block: 2.5rem 4rem; }
  .hours__header { margin-bottom: 2rem; }
  .hours__eyebrow {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .hours h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .hours__intro {
    margin-top: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 66ch;
  }
  .hours__h2 { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 700; margin-bottom: 0.5rem; }
  .hours__desc { color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: 1rem; }
  .hours__section { margin-top: var(--space-block); }

  .hours__loading, .hours__stamp { color: var(--color-muted); font-size: var(--text-sm); }
  .hours__stamp { margin-top: 0.6rem; font-variant-numeric: tabular-nums; }
  .hours__empty {
    display: grid;
    gap: 0.35rem;
    border: 2px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    background: var(--color-surface-light);
    padding: 1rem 1.15rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
  .hours__empty strong { color: var(--color-text-primary); }

  .hours__tablewrap {
    overflow-x: auto;
    border: 3px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-1);
    background: var(--color-surface);
  }
  .hours__table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 22rem; }
  .hours__table th, .hours__table td { text-align: start; padding: 0.7rem 0.95rem; border-block-end: 1px solid var(--color-border-light); }
  .hours__table thead th {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-surface-light);
  }
  .hours__table tbody tr:last-child th, .hours__table tbody tr:last-child td { border-block-end: 0; }
  .hours__table tbody th { font-weight: 700; }
  .hours__table th.is-today { color: var(--color-accent); }
  .hours__time, .hours__crowd { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hours__crowd { text-align: end; }

  .hours__faq { display: grid; gap: 0.85rem; }
  .hours__faq h3 { font-size: var(--text-lg); font-weight: 700; margin-bottom: 0.35rem; }
  .hours__faq p { color: var(--color-text-secondary); line-height: 1.65; max-width: 68ch; }
  .hours__source { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6; max-width: 68ch; }
  .hours__link { font-weight: 700; color: var(--color-accent); }
  .hours__link:hover { text-decoration: underline; }

  .hours__related { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hours__related a {
    display: inline-flex;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.55rem 0.9rem;
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }
  .hours__related a:hover { border-color: var(--color-accent); color: var(--color-accent); }

  @media (min-width: 768px) {
    .hours__faq { grid-template-columns: repeat(2, 1fr); }
  }
</style>

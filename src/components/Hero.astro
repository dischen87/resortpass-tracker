---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12 md:pt-16 md:pb-20">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Left column: text -->
      <div class="relative z-10">
        <!-- Badge -->
        <div class="mb-6 animate-fade-in-up">
          <span class="badge">
            <span class="badge-dot"></span>
            {tr('hero.badge')}
          </span>
        </div>

        <!-- Main heading -->
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.1] mb-6 animate-fade-in-up-delay-1" style="font-family: var(--font-heading);">
          {tr('hero.title')}
        </h1>

        <!-- Subtitle -->
        <p class="text-text-secondary text-lg leading-relaxed mb-8 max-w-lg animate-fade-in-up-delay-2">
          {tr('hero.subtitle')}
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row items-start gap-3 mb-10 animate-fade-in-up-delay-3">
          <a href="#benachrichtigung" class="btn-primary cursor-pointer">
            {tr('subscribe.sticky_cta')}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="#info" class="btn-secondary cursor-pointer">
            Info
          </a>
        </div>

        <!-- Stats bar -->
        <div class="flex items-center gap-8 sm:gap-12 animate-fade-in-up-delay-3">
          <div>
            <p class="text-3xl font-bold" style="font-family: var(--font-heading);" id="fan-count">---</p>
            <p class="text-sm text-muted">{tr('subscribe.waiting_fans')}</p>
          </div>
          <div>
            <p class="text-3xl font-bold" style="font-family: var(--font-heading);">15 min</p>
            <p class="text-sm text-muted">{tr('status.updated_3x')}</p>
          </div>
        </div>
      </div>

      <!-- Right column: decorative card -->
      <div class="relative hidden lg:block animate-fade-in-up-delay-2">
        <!-- Floating decorative elements -->
        <div class="absolute -top-4 -right-4 w-14 h-14 rounded-full bg-red/20 border-2 border-border flex items-center justify-center animate-float z-10">
          <svg class="w-6 h-6 text-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <div class="absolute -bottom-2 -left-4 w-12 h-12 rounded-full bg-accent/15 border-2 border-border flex items-center justify-center animate-float-delay z-10">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <div class="absolute top-1/2 -right-6 w-11 h-11 rounded-full bg-available/15 border-2 border-border flex items-center justify-center animate-float z-10">
          <svg class="w-5 h-5 text-available" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <!-- Main hero card -->
        <div class="card p-6 md:p-8">
          <!-- Status preview -->
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-accent/10 border-2 border-accent/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-sm">ResortPass Silver</p>
              <p class="text-xs text-muted">{tr('status.silver_includes')}</p>
            </div>
          </div>

          <!-- Progress-like element -->
          <div class="mb-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-text-secondary">Status</span>
              <span class="text-sm font-bold text-accent">Live</span>
            </div>
            <div class="w-full h-3 rounded-full bg-bg border-2 border-border-light overflow-hidden">
              <div class="h-full rounded-full bg-accent" style="width: 100%;"></div>
            </div>
          </div>

          <!-- Action button preview -->
          <div class="btn-primary w-full text-center py-3">
            {tr('subscribe.sticky_cta')}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, crowdCalendarPaths, getTranslation } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';
import BrandSafeText from './BrandSafeText.astro';
import { getLocaleDefinition } from '../i18n/locales';
import { getBuildTimeStatus } from '../data/status-snapshot';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);

/*
 * The answer ships in the HTML. These pills used to read "Wird geprüft…" for
 * anything that does not run JavaScript — which is every answer engine and, on
 * the first paint, every visitor.
 */
const snapshot = await getBuildTimeStatus();
const pillText = (state: 'available' | 'sold_out' | 'unknown') =>
  state === 'available' ? tr('status.available')
  : state === 'sold_out' ? tr('status.sold_out')
  : tr('status.unknown_short');
const lastCheckDate = snapshot.capturedAt ? new Date(snapshot.capturedAt) : null;
const lastCheckLabel = lastCheckDate && !Number.isNaN(lastCheckDate.getTime())
  ? `${tr('status.last_check')}: ${lastCheckDate.toLocaleString(getLocaleDefinition(lang).bcp47, { dateStyle: 'medium', timeStyle: 'short' })} · ${tr('status.updated_3x')}`
  : tr('status.updated_3x');
const titleLead = tr('hero.title_lead');
const titleHighlight = tr('hero.title_highlight');
const answerLabel = tr('hero.answer_label');
const howLabel = tr('hero.how_label');
const exploreLabel = tr('hero.explore_label');
const planningLabel = tr('nav.plan_visit');
const compareLabel = tr('nav.compare_passes');

const homePath = getRoutePath('home', lang)!;
const features = [
  { href: getRoutePath('waitTimes', lang)!, icon: 'tabler:clock-hour-4', label: tr('nav.wait_times'), tint: 'accent', live: true },
  { href: crowdCalendarPaths[lang], icon: 'tabler:calendar-stats', label: tr('nav.crowd_forecast'), tint: 'gold', live: true },
  { href: getRoutePath('parkGuide', lang)!, icon: 'tabler:map-2', label: planningLabel, tint: 'pink', live: false },
  { href: getRoutePath('resortPassCompare', lang)!, icon: 'tabler:scale', label: compareLabel, tint: 'accent', live: false },
];
---

<section class="relative overflow-hidden">
  <!-- Floating decorative marks -->
  <span class="deco deco--pink-circle" aria-hidden="true"></span>
  <span class="deco deco--purple-dot" aria-hidden="true"></span>
  <span class="deco deco--yellow-square" aria-hidden="true"></span>
  <span class="deco deco--purple-square" aria-hidden="true"></span>

  <div class="section-shell relative z-10 pb-8 pt-8 text-center md:pb-10 md:pt-16">
    <div class="mx-auto max-w-[56.25rem]">
      <div class="mb-6 animate-fade-in-up">
        <span class="badge">
          <Icon name="tabler:rollercoaster" class="h-4 w-4 text-pink" aria-hidden="true" />
          {tr('hero.badge')}
        </span>
      </div>

      <h1 class="mb-6 text-[2.15rem] font-extrabold leading-[1.02] tracking-[-0.015em] md:text-5xl lg:text-[3.65rem] animate-fade-in-up-delay-1">
        <span class="block"><BrandSafeText text={titleLead} /></span>
        <span class="highlight-swipe"><BrandSafeText text={titleHighlight} /></span>
      </h1>

      <div class="hero-status mx-auto mb-7 max-w-2xl animate-fade-in-up-delay-2">
        <p class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted">
          {answerLabel} · <span id="hero-status-time">{lastCheckLabel}</span>
        </p>
        <p class="mb-3 text-left text-[0.98rem] leading-relaxed text-text-secondary md:text-[1.05rem]">
          {tr('hero.subtitle')}
        </p>
        <div class="flex flex-wrap gap-2" role="status" aria-live="polite">
          <span class="hero-pill" id="hero-pill-silver" data-state={snapshot.silver.state}>
            <span class="dot" aria-hidden="true"></span>
            <span class="hero-status-label">Silver</span>
            <span class="hero-status-value" id="hero-status-silver">{pillText(snapshot.silver.state)}</span>
          </span>
          <span class="hero-pill" id="hero-pill-gold" data-state={snapshot.gold.state}>
            <span class="dot" aria-hidden="true"></span>
            <span class="hero-status-label">Gold</span>
            <span class="hero-status-value" id="hero-status-gold">{pillText(snapshot.gold.state)}</span>
          </span>
        </div>
      </div>

      <div id="hero-cta" class="mb-5 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center animate-fade-in-up-delay-3">
        <a href="#benachrichtigung" class="btn-primary min-h-14 px-8">
          <Icon name="tabler:bell-ringing" class="icon-bell h-5 w-5" aria-hidden="true" />
          {tr('subscribe.sticky_cta')}
        </a>
        <a href="#info" class="btn-secondary min-h-14 px-7">
          <Icon name="tabler:info-circle" class="h-5 w-5" aria-hidden="true" />
          {howLabel}
        </a>
      </div>

      <div class="hero-live animate-fade-in-up-delay-3">
        <span class="hero-live-badge"><span class="hero-live-dot" aria-hidden="true"></span>Live</span>
        <span class="hero-live-number" id="fan-count" data-countup>800</span>
        <span class="hero-live-label">{tr('subscribe.waiting_fans')} <span class="text-muted">· {tr('subscribe.privacy').split('.')[0]}</span></span>
      </div>

      <nav class="hero-features animate-fade-in-up-delay-4" aria-label={exploreLabel}>
        {features.map((feature) => (
          <a href={feature.href} class:list={['hero-feature', `hero-feature-${feature.tint}`]}>
            <Icon name={feature.icon} class="hero-feature-icon h-4 w-4" aria-hidden="true" />
            <span>{feature.label}</span>
            {feature.live && <span class="hero-feature-live" aria-hidden="true"></span>}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Signature dotted rollercoaster track with a little train riding the crest -->
  <svg class="coaster" viewBox="0 0 1440 150" width="100%" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
    <path id="coaster-track" class="coaster-track" d="M0,120 C200,120 300,58 520,66 C760,74 820,134 1040,106 C1240,82 1320,66 1440,74" />
    <g class="coaster-cars">
      <circle class="car-anim" r="11" fill="#FACC15" stroke="#EC4899" stroke-width="3">
        <animateMotion dur="16s" repeatCount="indefinite" rotate="auto" calcMode="linear"><mpath href="#coaster-track" /></animateMotion>
      </circle>
      <circle class="car-anim" r="13" fill="#EC4899" stroke="#2E1065" stroke-width="3">
        <animateMotion dur="16s" begin="-1.05s" repeatCount="indefinite" rotate="auto" calcMode="linear"><mpath href="#coaster-track" /></animateMotion>
      </circle>
      <circle class="car-anim" r="9" fill="#F9A8D4" stroke="#2E1065" stroke-width="2.5">
        <animateMotion dur="16s" begin="-1.95s" repeatCount="indefinite" rotate="auto" calcMode="linear"><mpath href="#coaster-track" /></animateMotion>
      </circle>
    </g>
    <g class="coaster-cars-static">
      <circle r="11" fill="#FACC15" stroke="#EC4899" stroke-width="3" cx="1204" cy="92" />
      <circle r="13" fill="#EC4899" stroke="#2E1065" stroke-width="3" cx="1272" cy="80" />
      <circle r="9" fill="#F9A8D4" stroke="#2E1065" stroke-width="2.5" cx="1332" cy="73" />
    </g>
  </svg>
</section>

---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="relative overflow-hidden">
  <!-- Background blobs -->
  <div class="blob blob-blue w-[500px] h-[500px] -top-40 -right-40" style="position: absolute;"></div>
  <div class="blob blob-white w-[400px] h-[400px] top-20 -left-32" style="position: absolute;"></div>
  <div class="blob blob-gold w-[300px] h-[300px] bottom-0 right-1/4" style="position: absolute;"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12 md:pt-20 md:pb-24 relative z-10">

    <div class="max-w-2xl mx-auto text-center lg:max-w-3xl">
      <!-- Badge -->
      <div class="mb-6 animate-fade-in-up">
        <span class="badge">
          <span class="badge-dot"></span>
          {tr('hero.badge')}
        </span>
      </div>

      <!-- Main heading -->
      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.1] mb-6 animate-fade-in-up-delay-1" style="font-family: var(--font-heading);">
        {tr('hero.title')}
      </h1>

      <!-- Subtitle -->
      <p class="text-text-secondary text-lg leading-relaxed mb-8 max-w-lg mx-auto animate-fade-in-up-delay-2">
        {tr('hero.subtitle')}
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10 animate-fade-in-up-delay-3">
        <a href="#benachrichtigung" class="btn-primary cursor-pointer">
          {tr('subscribe.sticky_cta')}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="#info" class="btn-secondary cursor-pointer">
          Info
        </a>
      </div>

      <!-- Stats bar -->
      <div class="flex items-center justify-center gap-8 sm:gap-12 animate-fade-in-up-delay-3">
        <div>
          <p class="text-3xl font-bold" style="font-family: var(--font-heading);" id="fan-count">---</p>
          <p class="text-sm text-muted">{tr('subscribe.waiting_fans')}</p>
        </div>
        <div>
          <p class="text-3xl font-bold" style="font-family: var(--font-heading);">15 min</p>
          <p class="text-sm text-muted">{tr('status.updated_3x')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

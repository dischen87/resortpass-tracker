---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
const titleLines: Record<Lang, [string, string]> = {
  de: ['Wann gibt es wieder', 'Europa-Park Jahreskarten?'],
  fr: ['Quand le ResortPass', 'Europa-Park sera-t-il à nouveau disponible ?'],
  it: ['Quando sarà di nuovo disponibile', 'il ResortPass Europa-Park?'],
  en: ['When will Europa-Park', 'annual passes be available again?'],
};
const [titleLead, titleHighlight] = titleLines[lang];
const answerLabel = { de: 'Antwort', fr: 'Réponse', it: 'Risposta', en: 'Answer' }[lang];
const howLabel = { de: "So funktioniert's", fr: 'Comment ça marche', it: 'Come funziona', en: 'How it works' }[lang];
---

<section class="relative overflow-hidden">
  <Icon name="tabler:confetti" class="absolute left-[5%] top-20 h-7 w-7 rotate-[-18deg] text-pink opacity-80" aria-hidden="true" />
  <Icon name="tabler:sparkles" class="absolute right-[7%] top-44 h-8 w-8 text-yellow" aria-hidden="true" />

  <div class="section-shell relative z-10 pb-14 pt-8 text-center md:pb-20 md:pt-16">
    <div class="mx-auto max-w-[56.25rem]">
      <div class="mb-6 animate-fade-in-up">
        <span class="badge">
          <Icon name="tabler:rollercoaster" class="h-4 w-4 text-pink" aria-hidden="true" />
          {tr('hero.badge')}
        </span>
      </div>

      <h1 class="mb-6 text-[2.15rem] font-extrabold leading-[1.02] tracking-[-0.015em] md:text-5xl lg:text-[3.65rem] animate-fade-in-up-delay-1">
        <span class="block">{titleLead}</span>
        <span class="highlight-swipe">{titleHighlight}</span>
      </h1>

      <div class="hero-status mx-auto mb-7 max-w-2xl animate-fade-in-up-delay-2" role="status" aria-live="polite" aria-atomic="true">
        <p class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted">
          {answerLabel} · <span id="hero-status-time">{tr('status.updated_3x')}</span>
        </p>
        <p class="mb-3 text-left text-[0.98rem] leading-relaxed text-text-secondary md:text-[1.05rem]">
          {tr('hero.subtitle')}
        </p>
        <div class="grid grid-cols-2 gap-2">
          <div class="hero-status-row rounded-full border-2 border-pink bg-pink/10 px-3">
            <span class="hero-status-label">Silver</span>
            <span class="hero-status-value" id="hero-status-silver">{tr('status.loading')}</span>
          </div>
          <div class="hero-status-row rounded-full border-2 border-pink bg-pink/10 px-3">
            <span class="hero-status-label">Gold</span>
            <span class="hero-status-value" id="hero-status-gold">{tr('status.loading')}</span>
          </div>
        </div>
      </div>

      <div id="hero-cta" class="mb-5 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center animate-fade-in-up-delay-3">
        <a href="#benachrichtigung" class="btn-primary min-h-14 px-8">
          <Icon name="tabler:bell-ringing" class="h-5 w-5" aria-hidden="true" />
          {tr('subscribe.sticky_cta')}
        </a>
        <a href="#info" class="btn-secondary min-h-14 px-7">
          <Icon name="tabler:info-circle" class="h-5 w-5" aria-hidden="true" />
          {howLabel}
        </a>
      </div>

      <p class="text-sm text-muted animate-fade-in-up-delay-3">
        <strong class="text-text-primary"><span id="fan-count">---</span> {tr('subscribe.waiting_fans')}</strong>
        <span aria-hidden="true"> · </span>
        <span>{tr('subscribe.privacy').split('.')[0]}</span>
      </p>
    </div>
  </div>

  <div class="h-14 md:h-20" aria-hidden="true"></div>
</section>

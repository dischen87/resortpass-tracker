---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
---

<section class="py-16 md:py-20" id="history">
  <div class="max-w-6xl mx-auto px-0 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <!-- Section header -->
      <div class="text-center mb-8 px-4 sm:px-0">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-accent/10 border-2 border-accent/30 mb-4">
          <svg class="w-7 h-7 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3" style="font-family: var(--font-heading);">{tr('history.title')}</h2>
        <p class="text-text-secondary max-w-lg mx-auto">{tr('history.desc')}</p>
      </div>

      <div class="sm:card sm:rounded-2xl p-0 sm:p-6 md:p-8" id="history-container" aria-live="polite">
        <!-- Loading state -->
        <div id="history-loading" class="text-center py-6 px-4 sm:px-0">
          <div class="inline-flex items-center gap-2 text-sm text-muted">
            <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>{tr('status.loading')}</span>
          </div>
        </div>

        <!-- No data state -->
        <div id="history-empty" class="hidden text-center py-8 px-4 sm:px-0">
          <div class="w-14 h-14 rounded-2xl bg-muted/10 border-2 border-border-light flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <p class="text-sm text-muted">{tr('history.no_data')}</p>
        </div>

        <!-- Stats display -->
        <div id="history-stats" class="hidden">
          <!-- Summary cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 px-4 sm:px-0">
            <div class="inner-card p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-silver/15 border-2 border-silver/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-silver" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                  </svg>
                </div>
                <span class="text-sm font-bold text-silver-light">Silver</span>
              </div>
              <div class="text-2xl font-bold font-mono" id="silver-pct">--</div>
              <p class="text-xs text-muted mt-1">{tr('history.available_pct')}</p>
            </div>
            <div class="inner-card p-5">
              <div class="flex items-center gap-2.5 mb-3">
                <div class="w-8 h-8 rounded-lg bg-gold/15 border-2 border-gold/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                </div>
                <span class="text-sm font-bold text-gold-light">Gold</span>
              </div>
              <div class="text-2xl font-bold font-mono" id="gold-pct">--</div>
              <p class="text-xs text-muted mt-1">{tr('history.available_pct')}</p>
            </div>
          </div>

          <div class="mb-6 text-center text-xs text-muted font-mono px-4 sm:px-0" id="tracking-since"></div>

          <h3 class="text-sm font-bold mb-3 px-4 sm:px-0" style="font-family: var(--font-heading);">{tr('history.recent_title')}</h3>
          <div class="overflow-hidden rounded-xl border-2 border-border-light sm:rounded-xl">
            <table class="w-full text-sm">
              <caption class="sr-only">{tr('history.recent_title')}</caption>
              <thead>
                <tr class="bg-bg text-left text-xs text-muted uppercase tracking-wider border-b-2 border-border-light">
                  <th scope="col" class="px-4 py-3">{tr('history.time')}</th>
                  <th scope="col" class="px-4 py-3 text-center">Silver</th>
                  <th scope="col" class="px-4 py-3 text-center">Gold</th>
                </tr>
              </thead>
              <tbody id="recent-checks-body">
                <tr>
                  <td colspan="3" class="px-4 py-4 text-center text-muted text-xs">{tr('status.loading')}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div id="pagination-controls" class="hidden flex items-center justify-between mt-4 px-4 sm:px-0">
            <button id="prev-page" class="px-3 py-1.5 text-xs font-bold rounded-lg border-2 border-border bg-surface text-muted hover:text-text-primary hover:shadow-[2px_2px_0px_var(--color-border)] transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed" disabled>
              &larr; {tr('history.prev')}
            </button>
            <span id="page-info" class="text-xs text-muted font-mono"></span>
            <button id="next-page" class="px-3 py-1.5 text-xs font-bold rounded-lg border-2 border-border bg-surface text-muted hover:text-text-primary hover:shadow-[2px_2px_0px_var(--color-border)] transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed" disabled>
              {tr('history.next')} &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ lang }}>
  window.__historyLang = lang;
</script>

<script>
  import { getTranslation, type Lang } from '../i18n/translations';

  const histLang = (window as any).__historyLang as Lang || 'de';
  const tr = (key: string) => getTranslation(histLang, key);

  const SHOP = 'https://tickets.mackinternational.de/de/resortpass/uebersicht';

  function statusBadge(available: boolean, shopUrl: string): string {
    if (available) {
      return `<a href="${shopUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-green-50 text-green-700 text-xs font-bold border-2 border-green-300 hover:bg-green-100 transition cursor-pointer">&#9679; ${tr('history.available_label')} &rarr;</a>`;
    }
    return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-red-50 text-red-600 text-xs font-bold border-2 border-red-300">&#9679; ${tr('history.sold_out_label')}</span>`;
  }

  async function loadHistory() {
    const loadingEl = document.getElementById('history-loading');
    const emptyEl = document.getElementById('history-empty');
    const statsEl = document.getElementById('history-stats');

    try {
      const [statsRes, recentRes] = await Promise.all([
        fetch('/api/history-stats'),
        fetch('/api/recent-checks?hours=168'),
      ]);

      if (!statsRes.ok) throw new Error('Failed to fetch stats');
      const data = await statsRes.json();

      loadingEl?.classList.add('hidden');

      if (!data || (!data.silver && !data.gold)) {
        emptyEl?.classList.remove('hidden');
        return;
      }

      statsEl?.classList.remove('hidden');

      const silverPct = document.getElementById('silver-pct');
      const goldPct = document.getElementById('gold-pct');
      const sincEl = document.getElementById('tracking-since');

      if (silverPct && data.silver) silverPct.textContent = `${data.silver.percentage.toFixed(1)}%`;
      if (goldPct && data.gold) goldPct.textContent = `${data.gold.percentage.toFixed(1)}%`;

      const trackingSince = data.silver?.trackingSince || data.gold?.trackingSince;
      if (sincEl && trackingSince) {
        const date = new Date(trackingSince + 'Z');
        const formatted = date.toLocaleDateString(histLang === 'de' ? 'de-CH' : histLang, { day: '2-digit', month: '2-digit', year: 'numeric' });
        sincEl.textContent = `${tr('history.tracking_since')} ${formatted}`;
      }

      if (recentRes.ok) {
        const checks = await recentRes.json();
        const tbody = document.getElementById('recent-checks-body');
        if (!tbody || !checks.length) return;

        const grouped: Record<string, { silver?: boolean; gold?: boolean }> = {};
        for (const check of checks) {
          const key = check.checked_at;
          if (!grouped[key]) grouped[key] = {};
          if (check.pass_type === 'silver') grouped[key].silver = !!check.available;
          if (check.pass_type === 'gold') grouped[key].gold = !!check.available;
        }

        const timestamps = Object.keys(grouped).sort().reverse();
        const merged: { time: string; silver?: boolean; gold?: boolean }[] = [];

        for (const ts of timestamps) {
          const existing = merged.find((m) => Math.abs(new Date(m.time + 'Z').getTime() - new Date(ts + 'Z').getTime()) < 5000);
          if (existing) {
            if (grouped[ts].silver !== undefined) existing.silver = grouped[ts].silver;
            if (grouped[ts].gold !== undefined) existing.gold = grouped[ts].gold;
          } else {
            merged.push({ time: ts, ...grouped[ts] });
          }
        }

        const locale = histLang === 'de' ? 'de-CH' : histLang === 'fr' ? 'fr-CH' : histLang === 'it' ? 'it-CH' : 'en-US';
        const PAGE_SIZE = 20;
        let currentPage = 0;
        const totalPages = Math.ceil(merged.length / PAGE_SIZE);

        function renderPage() {
          const start = currentPage * PAGE_SIZE;
          const pageItems = merged.slice(start, start + PAGE_SIZE);
          tbody!.innerHTML = pageItems.map((row) => {
            const date = new Date(row.time + 'Z');
            const timeStr = date.toLocaleDateString(locale, { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
            const silverHtml = row.silver !== undefined ? statusBadge(row.silver, SHOP) : '<span class="text-muted text-xs">—</span>';
            const goldHtml = row.gold !== undefined ? statusBadge(row.gold, SHOP) : '<span class="text-muted text-xs">—</span>';
            return `<tr class="border-t-2 border-border-light"><td class="px-4 py-3 font-mono text-xs text-text-secondary whitespace-nowrap">${timeStr}</td><td class="px-4 py-3 text-center">${silverHtml}</td><td class="px-4 py-3 text-center">${goldHtml}</td></tr>`;
          }).join('');

          const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
          const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
          const pageInfo = document.getElementById('page-info');
          if (prevBtn) prevBtn.disabled = currentPage === 0;
          if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
          if (pageInfo) pageInfo.textContent = tr('history.page_info').replace('{page}', String(currentPage + 1)).replace('{total}', String(totalPages));
        }

        if (totalPages > 1) {
          document.getElementById('pagination-controls')?.classList.remove('hidden');
          document.getElementById('prev-page')?.addEventListener('click', () => { if (currentPage > 0) { currentPage--; renderPage(); } });
          document.getElementById('next-page')?.addEventListener('click', () => { if (currentPage < totalPages - 1) { currentPage++; renderPage(); } });
        }
        renderPage();
      }
    } catch {
      loadingEl?.classList.add('hidden');
      emptyEl?.classList.remove('hidden');
    }
  }

  loadHistory();
</script>

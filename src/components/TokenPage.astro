---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Navbar from './Navbar.astro';
import '../styles/global.css';
import { getTranslation, type Lang } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';

interface Props {
  lang: Lang;
  mode: 'confirm' | 'unsubscribe';
}

const { lang, mode } = Astro.props;
const tr = (key: string) => getTranslation(lang, key);
const isConfirm = mode === 'confirm';
const key = isConfirm ? 'confirm' : 'unsub';
const initialTitleKey = isConfirm ? 'confirm.processing_title' : 'unsub.confirm_title';
const homePath = getRoutePath('home', lang)!;
---

<Layout
  lang={lang}
  routeKey={isConfirm ? 'confirm' : 'unsubscribe'}
  title={`${tr(initialTitleKey)} — ResortPass Tracker`}
  description={isConfirm ? tr('confirm.success') : tr('unsub.confirm_prompt')}
  noindex
>
  <Navbar lang={lang} />
  <main id="main-content" class="mx-auto min-h-[70vh] max-w-2xl px-4 py-14 text-center md:py-20">
    <div class="glass-card mx-auto max-w-md p-8 shadow-[5px_5px_0_#C4B5FD] animate-fade-in-up md:p-10">
      <img src="/favicon.svg" alt="" width="56" height="56" class="mx-auto mb-5 h-14 w-14" />
      <p class="section-kicker mb-3">ResortPass Tracker</p>
      <h1 id="token-title" class="text-2xl font-bold mb-3">{tr(initialTitleKey)}</h1>

      <p class="flex items-center justify-center gap-2 text-text-secondary text-sm mb-6 leading-relaxed" id="token-message" role="status" aria-live="polite">
        {isConfirm && <span class="spinner shrink-0 text-accent" aria-hidden="true"></span>}
        <span id="token-message-text">{isConfirm ? tr('confirm.processing') : tr('unsub.confirm_prompt')}</span>
      </p>

      {!isConfirm && (
        <button type="button" id="unsubscribe-button" class="btn-primary w-full mb-6">
          {tr('unsub.submit')}
        </button>
      )}

      <div id="token-success" class="hidden mb-6 rounded-xl bg-green-50 border-2 border-green-200 p-4">
        <p class="flex items-start justify-center gap-2 text-sm text-available"><Icon name="tabler:circle-check" class="h-5 w-5 shrink-0" aria-hidden="true" />{tr(`${key}.success`)}</p>
      </div>

      <a href={homePath} class="inline-flex items-center text-sm font-bold text-accent hover:underline">
        {tr(`${key}.back`)}
      </a>
    </div>
  </main>

  <script define:vars={{ lang, mode }}>
    window.__tokenPage = { lang, mode };
  </script>

  <script>
    import { getTranslation, type Lang } from '../i18n/translations';

    const config = (window as any).__tokenPage as { lang: Lang; mode: 'confirm' | 'unsubscribe' };
    const tr = (key: string) => getTranslation(config.lang, key);
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');
    const message = document.getElementById('token-message')!;
    const messageText = document.getElementById('token-message-text')!;
    const success = document.getElementById('token-success')!;
    const title = document.getElementById('token-title')!;
    const button = document.getElementById('unsubscribe-button') as HTMLButtonElement | null;

    function stopSpinner() {
      message.querySelector('.spinner')?.remove();
    }

    function showError() {
      stopSpinner();
      messageText.textContent = tr(`${config.mode === 'confirm' ? 'confirm' : 'unsub'}.error`);
      message.classList.add('text-unavailable', 'font-bold');
      if (button) {
        button.disabled = false;
        button.textContent = tr('unsub.submit');
      }
    }

    function showSuccess() {
      stopSpinner();
      title.textContent = tr(`${config.mode === 'confirm' ? 'confirm' : 'unsub'}.title`);
      messageText.textContent = '';
      success.classList.remove('hidden');
      button?.remove();
    }

    async function confirm() {
      if (!token) return showError();
      try {
        const response = await fetch(`/api/confirm?token=${encodeURIComponent(token)}&lang=${config.lang}`);
        const data = await response.json();
        if (!response.ok || !data.success) return showError();
        showSuccess();
      } catch {
        showError();
      }
    }

    async function unsubscribe() {
      if (!token || !button) return showError();
      button.disabled = true;
      button.innerHTML = '<span class="spinner" aria-hidden="true"></span>';
      messageText.textContent = tr('unsub.processing');
      try {
        const response = await fetch('/api/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, lang: config.lang }),
        });
        const data = await response.json();
        if (!response.ok || !data.success) return showError();
        showSuccess();
      } catch {
        showError();
      }
    }

    if (config.mode === 'confirm') confirm();
    else button?.addEventListener('click', unsubscribe);
  </script>
</Layout>

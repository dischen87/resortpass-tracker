---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, crowdCalendarPaths, getTranslation } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
  showLanguageSwitcher?: boolean;
}

const lang = Astro.props.lang || defaultLang;
const showLanguageSwitcher = Astro.props.showLanguageSwitcher ?? true;
const tr = (key: string) => getTranslation(lang, key);
const imprintPath = getRoutePath('imprint', lang)!;
const homePath = getRoutePath('home', lang)!;
const waitTimesPath = getRoutePath('waitTimes', lang)!;
const crowdCalendarPath = crowdCalendarPaths[lang];
const isCrowdCalendarPage = Object.values(crowdCalendarPaths).includes(Astro.url.pathname as (typeof crowdCalendarPaths)[Lang]);
const ctaTitle = tr('footer.cta_title');
const planningLabel = tr('nav.plan_visit');
const passGuideLabel = tr('nav.resortpass_guide');
// Published in five languages; the rest link to the English edition, the same
// convention the header uses. "Open Source" was claimed twice on the site
// without the repository being linked anywhere.
const methodologyPath = getRoutePath('methodology', lang) || getRoutePath('methodology', 'en')!;
const openingHoursPath = getRoutePath('openingHours', lang) || getRoutePath('openingHours', 'en')!;
const openingHoursLabel = { de: 'Öffnungszeiten', en: 'Opening hours', fr: 'Horaires d’ouverture', nl: 'Openingstijden', it: 'Orari di apertura' }[lang as string] || 'Opening hours';
const methodologyLabel = { de: 'Methodik', en: 'Methodology', fr: 'Méthodologie', nl: 'Methodiek', it: 'Metodologia' }[lang as string] || 'Methodology';
---

<section class="py-16 md:py-20" aria-label={tr('subscribe.title')}>
  <div class="section-shell">
    <div class="relative overflow-hidden rounded-3xl border-[3px] border-border bg-text-primary px-6 py-10 text-center text-white shadow-[6px_6px_0_var(--color-pink)] md:px-12 md:py-12">
      <Icon name="tabler:confetti" class="absolute left-5 top-5 h-8 w-8 text-yellow opacity-80" aria-hidden="true" />
      <Icon name="tabler:sparkles" class="absolute bottom-5 right-6 h-8 w-8 text-pink" aria-hidden="true" />
      <h2 class="mx-auto mb-3 max-w-2xl text-3xl font-extrabold leading-tight md:text-4xl">{ctaTitle}</h2>
      <p class="mx-auto mb-7 max-w-xl text-sm leading-relaxed text-violet-100 md:text-base">{tr('subscribe.desc')}</p>
      <a href={`${homePath}#benachrichtigung`} class="btn-primary border-white bg-yellow px-7 text-text-primary shadow-[4px_4px_0_white] hover:shadow-[6px_6px_0_white]">
        <Icon name="tabler:bell-ringing" class="h-5 w-5" aria-hidden="true" />
        {tr('subscribe.sticky_cta')}
      </a>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-violet-100">
        <span class="inline-flex items-center gap-1.5"><Icon name="tabler:check" class="h-4 w-4 text-yellow" aria-hidden="true" />{tr('subscribe.privacy').split('.')[0]}</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="tabler:shield-check" class="h-4 w-4 text-yellow" aria-hidden="true" />{tr('footer.no_tracking')}</span>
      </div>
    </div>
  </div>
</section>

<footer class="border-t-[3px] border-border bg-white pt-12">
  <div class="section-shell">
    <div class="grid grid-cols-1 gap-9 md:grid-cols-4 md:gap-12">
      <div class="md:col-span-2">
        <a href={homePath} aria-label="ResortPass Tracker" class="mb-4 inline-flex items-center gap-2.5 rounded-xl">
          <img src="/favicon.svg" alt="" width="44" height="44" class="h-11 w-11" />
          <span class="brand-wordmark">resortpass<span>tracker</span></span>
        </a>
        <p class="mb-4 max-w-sm text-sm leading-relaxed text-muted">{tr('footer.disclaimer')}</p>
        <p class="flex items-start gap-1.5 text-xs font-bold text-muted">
          <Icon name="tabler:shield-check" class="mt-0.5 h-4 w-4 shrink-0 text-available" aria-hidden="true" />
          {tr('footer.no_tracking')}
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-extrabold">Links</h3>
        <ul class="space-y-2.5">
          <li><a href={waitTimesPath} class="text-sm text-muted hover:text-text-primary">{tr('nav.wait_times')}</a></li>
          <li><a href={crowdCalendarPath} class="text-sm text-muted hover:text-text-primary">{tr('nav.crowd_forecast')}</a></li>
          <li><a href={openingHoursPath} class="text-sm text-muted hover:text-text-primary">{openingHoursLabel}</a></li>
          <li><a href={getRoutePath('parkGuide', lang)!} class="text-sm text-muted hover:text-text-primary">{planningLabel}</a></li>
          <li><a href={getRoutePath('resortPassGuide', lang)!} class="text-sm text-muted hover:text-text-primary">{passGuideLabel}</a></li>
          <li><a href={`${homePath}#benachrichtigung`} class="text-sm text-muted hover:text-text-primary">{tr('subscribe.sticky_cta')}</a></li>
          <li><a href={`${homePath}#info`} class="text-sm text-muted hover:text-text-primary">Info</a></li>
          <li><a href={`${homePath}#history`} class="text-sm text-muted hover:text-text-primary">{tr('history.title')}</a></li>
          <li><a href={`/api/feed.xml?lang=${lang}`} class="text-sm text-muted hover:text-text-primary">RSS</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-extrabold">{tr('footer.imprint')}</h3>
        <ul class="space-y-2.5">
          <li><a href={imprintPath} class="text-sm text-muted hover:text-text-primary">{tr('footer.imprint')}</a></li>
          <li><a href={methodologyPath} class="text-sm text-muted hover:text-text-primary">{methodologyLabel}</a></li>
          <li>
            <a href="https://github.com/dischen87/resortpass-tracker" rel="noopener noreferrer" target="_blank" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-text-primary">
              GitHub
              <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
            </a>
          </li>
        </ul>
        {showLanguageSwitcher && (
          <div class="mt-6">
            <LanguageSwitcher lang={lang} paths={isCrowdCalendarPage ? crowdCalendarPaths : undefined} />
          </div>
        )}
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t-2 border-border-light py-6 sm:flex-row sm:items-center">
      <p class="text-xs text-muted">{tr('footer.unsubscribe_hint')}</p>
      <p class="text-xs text-muted">&copy; {new Date().getFullYear()} ResortPass Tracker</p>
    </div>
  </div>
  <div class="striped-rule" aria-hidden="true"></div>
</footer>

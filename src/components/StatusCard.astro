---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';
import { getBuildTimeStatus } from '../data/status-snapshot';
import { getStatusCopy } from '../data/availability-answer';
import { formatPassCheck, formatPassLabel } from '../data/status-format';
import { getLocaleDefinition } from '../i18n/locales';

interface Props {
  type: 'silver' | 'gold';
  lang?: Lang;
}

const { type } = Astro.props;
const lang = Astro.props.lang || defaultLang;
/*
 * Only the branch that is actually true gets rendered. The others used to ship
 * as hidden markup, so the served HTML claimed both "sold out" and "on sale
 * now — buy" at the same time.
 */
const snapshot = await getBuildTimeStatus();
const state = snapshot[type].state;
const statusCopy = getStatusCopy(lang);
const passLabel = formatPassLabel(snapshot[type], statusCopy);
const passCheck = formatPassCheck(snapshot[type], statusCopy, getLocaleDefinition(lang).bcp47);
const tr = (key: string) => getTranslation(lang, key);
const isGold = type === 'gold';
const shopUrl = 'https://tickets.mackinternational.de/de/resortpass/uebersicht';
const detailsUrl = isGold
  ? 'https://www.europapark.de/de/resortpass/europa-park-resortpass-gold'
  : 'https://www.europapark.de/de/resortpass/europa-park-resortpass-silver';
const label = `ResortPass ${isGold ? 'Gold' : 'Silver'}`;
const priceAdult = isGold ? '495' : '325';
const priceChild = isGold ? '430' : '275';
const includes = tr(isGold ? 'status.gold_includes' : 'status.silver_includes');
const tier = isGold ? 'Premium' : 'Classic';
---

<article
  id={`card-${type}`}
  class:list={['card reveal p-6 md:p-7', isGold ? 'card-gold' : 'card-silver']}
  style={`--i:${isGold ? 1 : 0}`}
  data-pass-type={type}
  data-pass-state={state}
  aria-labelledby={`${type}-title`}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h2 id={`${type}-title`} class="text-[1.35rem] font-extrabold leading-tight">{label}</h2>
      <p class="mt-1 text-sm leading-snug text-muted">{includes}</p>
    </div>
    <span class:list={[
      'shrink-0 rounded-full border-2 px-3 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.08em]',
      isGold ? 'border-gold bg-amber-50 text-gold-light' : 'border-accent bg-bg-light text-accent',
    ]}>{tier}</span>
  </div>

  <div data-pass-status role="status" aria-live="polite" aria-atomic="true">
    <div class="pass-status flex min-h-12 items-center gap-3 rounded-2xl px-4 py-3" data-state={state}>
      <span class="h-3 w-3 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
      <span class="font-heading text-lg font-extrabold" data-pass-label>{passLabel}</span>
    </div>
    {state === 'available' && (
      <a data-pass-buy href={shopUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-3 w-full bg-available py-3 text-base">
        {tr('status.buy_now')}
        <Icon name="tabler:arrow-right" class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
      </a>
    )}
  </div>
  <p data-pass-check class="mt-3 text-xs leading-relaxed text-muted">{passCheck}</p>

  <div class:list={['inner-card mt-5 overflow-hidden', isGold ? 'bg-amber-50' : 'bg-bg-light']}>
    <table class="w-full text-sm">
      <caption class="px-4 pb-1 pt-3 text-start font-mono text-[0.62rem] uppercase tracking-[0.13em] text-muted">
        {tr('status.price_caption')}
      </caption>
      <tbody>
        <tr class="border-b-2 border-bg">
          <th scope="row" class="px-4 py-2.5 text-start font-normal text-text-secondary">{tr('status.adults')}</th>
          <td class="px-4 py-2.5 text-end font-bold tabular-nums">{priceAdult}&thinsp;&euro;</td>
        </tr>
        <tr>
          <th scope="row" class="px-4 py-2.5 text-start font-normal text-text-secondary">{tr('status.children')}</th>
          <td class="px-4 py-2.5 text-end font-bold tabular-nums">{priceChild}&thinsp;&euro;</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
    <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg py-2 text-sm font-bold text-accent hover:underline">
      {tr('status.to_shop')}
      <Icon name="tabler:external-link" class="h-4 w-4" aria-hidden="true" />
    </a>
    <a href={detailsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg py-2 text-xs font-bold text-muted hover:text-accent hover:underline">
      {tr('status.official_details')}
      <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .pass-status[data-state='available'] { background: #f0fdf4; color: var(--color-available); }
  .pass-status[data-state='sold_out'] { background: rgb(236 72 153 / 0.1); color: var(--color-unavailable); }
  .pass-status[data-state='unknown'] { background: var(--color-bg-light); color: var(--color-muted); }
</style>

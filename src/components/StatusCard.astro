---
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';

interface Props {
  type: 'silver' | 'gold';
  lang?: Lang;
}

const { type } = Astro.props;
const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);

const isGold = type === 'gold';
const shopUrl = 'https://tickets.mackinternational.de/de/resortpass/uebersicht';
const detailsUrl = isGold
  ? 'https://www.europapark.de/de/resortpass/europa-park-resortpass-gold'
  : 'https://www.europapark.de/de/resortpass/europa-park-resortpass-silver';

const config = {
  gold: {
    label: 'ResortPass Gold',
    priceAdult: '495',
    priceChild: '430',
    includes: tr('status.gold_includes'),
    cardClass: 'card-gold',
    iconBg: 'bg-gold/15',
    iconBorder: 'border-gold/40',
    iconColor: 'text-gold',
    labelColor: 'text-gold-light',
    badgeClass: 'bg-gold/10 text-gold-light border-2 border-gold/30',
  },
  silver: {
    label: 'ResortPass Silver',
    priceAdult: '325',
    priceChild: '275',
    includes: tr('status.silver_includes'),
    cardClass: 'card-silver',
    iconBg: 'bg-silver/15',
    iconBorder: 'border-silver/40',
    iconColor: 'text-silver',
    labelColor: 'text-silver-light',
    badgeClass: 'bg-silver/10 text-silver-light border-2 border-silver/30',
  },
};

const c = config[type];
---

<div
  id={`card-${type}`}
  class:list={[
    'card rounded-2xl p-6 md:p-8 transition-all duration-300',
    c.cardClass,
  ]}
  data-pass-type={type}
>
  <!-- Card Header -->
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
      <div class:list={['w-10 h-10 rounded-xl flex items-center justify-center border-2', c.iconBg, c.iconBorder]}>
        {isGold ? (
          <svg class:list={['w-5 h-5', c.iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        ) : (
          <svg class:list={['w-5 h-5', c.iconColor]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        )}
      </div>
      <div>
        <h2 class:list={['text-base font-bold', c.labelColor]} style="font-family: var(--font-heading);">
          {c.label}
        </h2>
        <p class="text-xs text-muted mt-0.5">{c.includes}</p>
      </div>
    </div>
    <span class:list={[
      'text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider',
      c.badgeClass,
    ]}>
      {isGold ? 'PREMIUM' : 'CLASSIC'}
    </span>
  </div>

  <!-- Status: Loading -->
  <div class="status-loading" role="status">
    <div class="flex items-center gap-3 py-2">
      <span class="relative flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full rounded-full bg-muted/50 animate-pulse"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-muted"></span>
      </span>
      <span class="text-sm text-muted">{tr('status.loading')}</span>
    </div>
  </div>

  <!-- Status: Unavailable -->
  <div class="status-unavailable hidden" role="status">
    <div class="flex items-center gap-3 py-2">
      <span class="relative flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-500 opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-unavailable"></span>
      </span>
      <span class="text-lg font-bold text-red-600" style="font-family: var(--font-heading);">{tr('status.sold_out')}</span>
    </div>
  </div>

  <!-- Status: Available -->
  <div class="status-available hidden" role="status">
    <div class="flex items-center gap-3 py-2">
      <span class="relative flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-available"></span>
      </span>
      <span class="text-lg font-bold text-green-600" style="font-family: var(--font-heading);">{tr('status.available')}</span>
    </div>
    <a
      href={shopUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 block rounded-xl bg-available py-3.5 text-center font-bold text-white border-2 border-border shadow-[3px_3px_0px_var(--color-border)] hover:shadow-[4px_4px_0px_var(--color-border)] hover:translate-x-[-1px] hover:translate-y-[-1px] active:shadow-none active:translate-x-[1px] active:translate-y-[1px] transition-all cursor-pointer"
    >
      {tr('status.buy_now')} &rarr;
    </a>
  </div>

  <!-- Status: Error -->
  <div class="status-error hidden" role="status">
    <p class="text-sm text-muted py-2">{tr('status.error')}</p>
  </div>

  <!-- Price Table -->
  <div class="mt-6 inner-card overflow-hidden">
    <table class="w-full text-sm">
      <caption class="sr-only">{c.label} {tr('status.price_caption')}</caption>
      <tbody>
        <tr class="border-b-2 border-border-light">
          <th scope="row" class="px-4 py-2.5 text-left font-normal text-text-secondary">{tr('status.adults')}</th>
          <td class="px-4 py-2.5 text-right font-bold tabular-nums">{c.priceAdult}&thinsp;&euro;</td>
        </tr>
        <tr>
          <th scope="row" class="px-4 py-2.5 text-left font-normal text-text-secondary">{tr('status.children')}</th>
          <td class="px-4 py-2.5 text-right font-bold tabular-nums">{c.priceChild}&thinsp;&euro;</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-muted">
    {tr('status.price_note')}
    <a href={detailsUrl} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-2">{tr('status.official_details')}</a>
  </p>

  <!-- Shop Link -->
  <div class="mt-5 flex items-center justify-between">
    <a
      href={shopUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex items-center gap-1.5 text-sm font-bold transition hover:underline cursor-pointer',
        isGold ? 'text-gold-light hover:text-gold' : 'text-silver-light hover:text-silver',
      ]}
    >
      {tr('status.to_shop')}
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>

---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import StatusCard from './StatusCard.astro';
import SubscribeForm from './SubscribeForm.astro';
import InfoSection from './InfoSection.astro';
import HistorySection from './HistorySection.astro';
import NewsSection from './NewsSection.astro';
import CommunitySection from './CommunitySection.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
import { getTranslation, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = (key: string) => getTranslation(lang, key);
const siteUrl = 'https://www.resortpass-europapark.ch';
const homePath = lang === 'de' ? '/' : `/${lang}/`;
const breadcrumbName = { de: 'Startseite', fr: 'Accueil', it: 'Home', en: 'Home' }[lang];
---

<Layout lang={lang}>
  <Navbar lang={lang} />

  <main id="main-content">
    <Hero lang={lang} />

    <section id="status" class="pt-6 pb-10 md:pt-8 md:pb-16" aria-labelledby="status-heading">
      <div class="section-shell">
        <h2 id="status-heading" class="sr-only">Status</h2>
        <div class="mx-auto grid max-w-[55rem] grid-cols-1 gap-7 md:grid-cols-2">
          <StatusCard type="silver" lang={lang} />
          <StatusCard type="gold" lang={lang} />
        </div>

        <p class="mt-7 text-center font-mono text-xs text-muted" id="last-check" role="status" aria-live="polite">
          <span id="last-check-text">{tr('status.loading')}</span>
        </p>
      </div>
    </section>

    <SubscribeForm lang={lang} />
    <InfoSection lang={lang} />
    <NewsSection lang={lang} />
    <HistorySection lang={lang} />
    <CommunitySection lang={lang} />
  </main>

  <Footer lang={lang} />

  <div id="sticky-cta" class="fixed bottom-0 left-0 right-0 z-50 pointer-events-none opacity-0 translate-y-full transition-[opacity,transform] duration-300 md:hidden" aria-hidden="true" inert>
    <div class="section-shell pb-4 pt-2">
      <div class="pointer-events-auto max-w-md mx-auto">
        <a href="#benachrichtigung" class="btn-primary w-full py-4 text-base">
          {tr('subscribe.sticky_cta')}
        </a>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 bg-bg/95 pointer-events-none backdrop-blur-sm"></div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ResortPass Tracker',
    alternateName: 'Europa-Park ResortPass availability tracker',
    url: siteUrl,
    inLanguage: ['de', 'fr', 'it', 'en'],
  })} />

  <script type="application/ld+json" id="schema-webpage" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: tr('meta.title'),
    url: `${siteUrl}${homePath}`,
    description: tr('meta.description'),
    inLanguage: lang,
    isPartOf: {
      '@type': 'WebSite',
      name: 'ResortPass Tracker',
      url: siteUrl,
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [{
        '@type': 'ListItem',
        position: 1,
        name: breadcrumbName,
        item: `${siteUrl}${homePath}`,
      }],
    },
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ResortPass Tracker',
    url: `${siteUrl}${homePath}`,
    description: tr('meta.description'),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    inLanguage: lang,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'EUR',
    },
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      [tr('info.what_title'), tr('info.what_text')],
      [tr('info.why_title'), tr('info.why_text')],
      [tr('info.how_title'), tr('info.how_text')],
      [tr('info.tip_title'), tr('info.tip_text')],
    ].map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  })} />

  <script define:vars={{ lang }}>
    window.__statusLang = lang;
  </script>

  <script>
    import { getTranslation, type Lang } from '../i18n/translations';

    const statusLang = ((window as any).__statusLang || 'de') as Lang;
    const tr = (key: string) => getTranslation(statusLang, key);
    const locale = statusLang === 'de' ? 'de-CH' : statusLang === 'fr' ? 'fr-CH' : statusLang === 'it' ? 'it-CH' : 'en-US';

    type PassStatus = { available?: boolean | null; state?: 'available' | 'sold_out' | 'unknown'; lastCheck?: string | null } | null;

    function stateOf(status: PassStatus): 'available' | 'sold_out' | 'unknown' {
      if (!status) return 'unknown';
      if (status.state) return status.state;
      if (status.available === true) return 'available';
      if (status.available === false) return 'sold_out';
      return 'unknown';
    }

    function parseTimestamp(value?: string | null): Date | null {
      if (!value) return null;
      const normalized = value.includes('T') ? value : value.replace(' ', 'T');
      const date = new Date(/[zZ]|[+-]\d\d:\d\d$/.test(normalized) ? normalized : `${normalized}Z`);
      return Number.isNaN(date.getTime()) ? null : date;
    }

    const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateCard(type: 'silver' | 'gold', status: PassStatus, didFetchFail = false) {
      const card = document.getElementById(`card-${type}`);
      if (!card) return;

      const state = didFetchFail ? 'error' : stateOf(status);
      const visibleBlock = state === 'available' ? 'available'
        : state === 'sold_out' ? 'unavailable'
        : state === 'error' ? 'error'
        : 'checking';

      card.classList.remove('card-available', 'card-unavailable');
      for (const block of ['loading', 'available', 'unavailable', 'checking', 'error']) {
        card.querySelector(`.status-${block}`)?.classList.toggle('hidden', block !== visibleBlock);
      }
      if (state === 'available') card.classList.add('card-available');
      if (state === 'sold_out') card.classList.add('card-unavailable');

      const pill = document.getElementById(`hero-pill-${type}`);
      const heroValue = document.getElementById(`hero-status-${type}`);
      if (pill && heroValue) {
        const pillState = state === 'available' ? 'available' : state === 'sold_out' ? 'sold_out' : 'unknown';
        const text = state === 'available' ? tr('status.available')
          : state === 'sold_out' ? tr('status.sold_out')
          : state === 'error' ? tr('status.unknown_short')
          : tr('status.checking');
        const apply = () => { heroValue.textContent = text; pill.dataset.state = pillState; };
        if (prefersReduce || heroValue.textContent === text) {
          apply();
        } else {
          heroValue.style.opacity = '0';
          window.setTimeout(() => { apply(); heroValue.style.opacity = '1'; }, 200);
        }
      }
    }

    async function loadStatus() {
      try {
        const response = await fetch('/api/status', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('status');
        const data = await response.json();
        updateCard('silver', data.silver);
        updateCard('gold', data.gold);

        const lastCheck = parseTimestamp(data.silver?.lastCheck || data.gold?.lastCheck);
        const text = lastCheck
          ? `${tr('status.last_check')}: ${lastCheck.toLocaleString(locale, { dateStyle: 'medium', timeStyle: 'short' })} · ${tr('status.updated_3x')}`
          : tr('status.updated_3x');
        document.getElementById('last-check-text')!.textContent = text;
        document.getElementById('hero-status-time')!.textContent = text;

        const schemaEl = document.getElementById('schema-webpage');
        if (schemaEl && lastCheck) {
          const schema = JSON.parse(schemaEl.textContent || '{}');
          schema.dateModified = lastCheck.toISOString();
          schemaEl.textContent = JSON.stringify(schema);
        }
      } catch {
        updateCard('silver', null, true);
        updateCard('gold', null, true);
        document.getElementById('last-check-text')!.textContent = tr('status.error');
        document.getElementById('hero-status-time')!.textContent = tr('status.error');
      }
    }

    function countUp(el: HTMLElement, to: number, format: (n: number) => string) {
      if (prefersReduce) { el.textContent = format(to); return; }
      const duration = 1000;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = format(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    async function loadFanCount() {
      try {
        const response = await fetch('/api/subscriber-count');
        if (!response.ok) return;
        const data = await response.json();
        const element = document.getElementById('fan-count');
        if (element && Number.isFinite(data.count)) countUp(element, data.count, (n) => n.toLocaleString(locale));
      } catch {}
    }

    // Shared scroll-reveal — reveal-once, then unobserve.
    // Safety net: if IntersectionObserver never ticks (dead/unsupported), reveal everything
    // so content is never permanently stuck at opacity:0.
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const revealAll = () => revealEls.forEach((el) => el.classList.add('is-in'));
    if (prefersReduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      let ioAlive = false;
      const revealObserver = new IntersectionObserver((entries, obs) => {
        ioAlive = true;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            obs.unobserve(entry.target);
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      revealEls.forEach((el) => revealObserver.observe(el));
      window.setTimeout(() => { if (!ioAlive) revealAll(); }, 1500);
    }

    loadStatus();
    loadFanCount();
    window.setInterval(loadStatus, 5 * 60 * 1000);

    const stickyCta = document.getElementById('sticky-cta');
    const subscribeSection = document.getElementById('benachrichtigung');
    const heroCta = document.getElementById('hero-cta');

    if (stickyCta && subscribeSection && heroCta) {
      let heroVisible = true;
      let subscribeVisible = false;
      const updateSticky = () => {
        const hide = heroVisible || subscribeVisible;
        stickyCta.toggleAttribute('inert', hide);
        stickyCta.setAttribute('aria-hidden', String(hide));
        stickyCta.classList.toggle('opacity-0', hide);
        stickyCta.classList.toggle('translate-y-full', hide);
        stickyCta.classList.toggle('opacity-100', !hide);
        stickyCta.classList.toggle('translate-y-0', !hide);
      };
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.target === heroCta) heroVisible = entry.isIntersecting;
          if (entry.target === subscribeSection) subscribeVisible = entry.isIntersecting;
        }
        updateSticky();
      }, { threshold: 0.1 });
      observer.observe(heroCta);
      observer.observe(subscribeSection);
    }
  </script>
</Layout>

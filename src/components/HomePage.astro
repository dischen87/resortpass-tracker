---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import StatusCard from './StatusCard.astro';
import SubscribeForm from './SubscribeForm.astro';
import InfoSection from './InfoSection.astro';
import HistorySection from './HistorySection.astro';
import NewsSection from './NewsSection.astro';
import CommunitySection from './CommunitySection.astro';
import PlanningTeaser from './PlanningTeaser.astro';
import JourneySection from './JourneySection.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
import { getTranslation, type Lang } from '../i18n/translations';
import { getRoutePath } from '../i18n/routes';
import { getBuildTimeStatus } from '../data/status-snapshot';
import { getAvailabilityAnswer, getStatusCopy } from '../data/availability-answer';
import { formatStatusDescription, formatStatusRequest } from '../data/status-format';
import { getLocaleDefinition } from '../i18n/locales';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = (key: string) => getTranslation(lang, key);
const siteUrl = 'https://www.resortpass-europapark.ch';
const homePath = getRoutePath('home', lang)!;
const breadcrumbName = tr('nav.home');
const localeTag = getLocaleDefinition(lang).bcp47;
const socialImageUrl = `${siteUrl}/og-resortpass-v3.png`;

/*
 * Rendered into the HTML so the page states when it last knew something, rather
 * than an indefinite "checking…". The island still refreshes it on load.
 */
const statusSnapshot = await getBuildTimeStatus();
const availabilityAnswer = await getAvailabilityAnswer(lang);
const statusCopy = getStatusCopy(lang);
const staticLastCheck = formatStatusRequest(statusSnapshot, statusCopy, localeTag);
const statusDescription = formatStatusDescription(statusSnapshot, statusCopy);
/*
 * Only the strings this island actually uses, serialised at build time.
 * Importing getTranslation pulled the whole 17-language table — 469 KB,
 * 121 KB gzipped — into the page's module graph and blocked every API
 * call behind it. The wait-times page already did it this way.
 */
const clientCopy = {
  'status.available': tr('status.available'),
  'status.buy_now': tr('status.buy_now'),
  'status.checking': tr('status.checking'),
  'status.error': tr('status.error'),
  'status.last_check': tr('status.last_check'),
  'status.sold_out': tr('status.sold_out'),
  'status.unknown_short': tr('status.unknown_short'),
  'status.updated_3x': tr('status.updated_3x')
};

---

<Layout lang={lang} routeKey="home" description={statusDescription}>
  <Navbar lang={lang} />

  <main id="main-content">
    <Hero lang={lang} />

    <section id="status" class="pt-6 pb-10 md:pt-8 md:pb-16" aria-labelledby="status-heading">
      <div class="section-shell">
        <h2 id="status-heading" class="sr-only">Status</h2>
        <div class="mx-auto grid max-w-[55rem] grid-cols-1 gap-7 md:grid-cols-2">
          <StatusCard type="silver" lang={lang} />
          <StatusCard type="gold" lang={lang} />
        </div>

        <p class="mt-7 text-center font-mono text-xs text-muted" id="last-check" role="status" aria-live="polite" aria-atomic="true">
          <span id="last-check-text">{staticLastCheck}</span>
        </p>
      </div>
    </section>

    <SubscribeForm lang={lang} />
    <JourneySection lang={lang} />
    <InfoSection lang={lang} />
    <PlanningTeaser lang={lang} />
    <NewsSection lang={lang} />
    <HistorySection lang={lang} />
    <CommunitySection lang={lang} />
  </main>

  <Footer lang={lang} />

  <div id="sticky-cta" class="fixed bottom-0 left-0 right-0 z-50 pointer-events-none opacity-0 translate-y-full transition-[opacity,transform] duration-300 md:hidden" aria-hidden="true" inert>
    <div class="section-shell pb-4 pt-2">
      <div class="pointer-events-auto max-w-md mx-auto">
        <a href="#benachrichtigung" class="btn-primary w-full py-4 text-base">
          {tr('subscribe.sticky_cta')}
        </a>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 bg-bg/95 pointer-events-none backdrop-blur-sm"></div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ResortPass Tracker',
    alternateName: 'Europa-Park ResortPass availability tracker',
    url: siteUrl,
    inLanguage: ['de', 'fr', 'it', 'en', 'nl', 'es', 'sv', 'ro', 'cs', 'pl', 'tr', 'da', 'el', 'pt', 'nb', 'he', 'hu'],
  })} />

  <script type="application/ld+json" id="schema-webpage" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: tr('meta.title'),
    url: `${siteUrl}${homePath}`,
    description: statusDescription,
    inLanguage: localeTag,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      contentUrl: socialImageUrl,
      width: 1200,
      height: 630,
      caption: tr('meta.og_alt'),
      representativeOfPage: true,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'ResortPass Tracker',
      url: siteUrl,
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [{
        '@type': 'ListItem',
        position: 1,
        name: breadcrumbName,
        item: `${siteUrl}${homePath}`,
      }],
    },
  })} />

  <script type="application/ld+json" id="schema-webapp" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ResortPass Tracker',
    url: `${siteUrl}${homePath}`,
    description: statusDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    inLanguage: localeTag,
    image: socialImageUrl,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'EUR',
    },
  })} />

  <script type="application/ld+json" id="availability-faq-schema" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      [tr('info.what_title'), tr('info.what_text')],
      [tr('info.why_title'), availabilityAnswer],
      [tr('info.how_title'), tr('info.how_text')],
      [tr('info.tip_title'), statusCopy.saleTiming],
    ].map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  })} />

  <script define:vars={{ lang, clientCopy, statusCopy }}>
    window.__statusLang = lang;
    window.__statusLangCopy = clientCopy;
    window.__statusCopy = statusCopy;
  </script>

  <script>
    import type { LocaleCode } from '../i18n/locales';
    import { getLocaleDefinition } from '../i18n/locales';
    import {
      createUnknownSnapshot, formatPassCheck, formatPassLabel, formatStatusAnswer, formatStatusDescription,
      formatStatusRequest, snapshotFromPayload, updateAvailabilityFaq,
      type StatusCopy, type StatusSnapshot,
    } from '../data/status-format';

    const statusLang = ((window as any).__statusLang || 'de') as LocaleCode;
    const clientCopy = (window as any).__statusLangCopy as Record<string, string>;
    const statusCopy = (window as any).__statusCopy as StatusCopy;
    const tr = (key: string) => clientCopy?.[key] ?? key;
    const locale = getLocaleDefinition(statusLang).bcp47;
    const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateCard(type: 'silver' | 'gold', snapshot: StatusSnapshot) {
      const pass = snapshot[type];
      const card = document.getElementById(`card-${type}`);
      if (card) {
        card.dataset.passState = pass.state;
        card.classList.toggle('card-available', pass.state === 'available');
        card.classList.toggle('card-unavailable', pass.state === 'sold_out');
        const panel = card.querySelector<HTMLElement>('[data-pass-status]');
        const banner = panel?.querySelector<HTMLElement>('[data-state]');
        if (banner) banner.dataset.state = pass.state;
        const label = card.querySelector<HTMLElement>('[data-pass-label]');
        if (label) label.textContent = formatPassLabel(pass, statusCopy);
        const checked = card.querySelector<HTMLElement>('[data-pass-check]');
        if (checked) checked.textContent = formatPassCheck(pass, statusCopy, locale);
        const existingBuy = panel?.querySelector('[data-pass-buy]');
        if (pass.state !== 'available') existingBuy?.remove();
        else if (panel && !existingBuy) {
          const buy = document.createElement('a');
          buy.dataset.passBuy = '';
          buy.href = 'https://tickets.mackinternational.de/de/resortpass/uebersicht';
          buy.target = '_blank';
          buy.rel = 'noopener noreferrer';
          buy.className = 'btn-primary mt-3 w-full bg-available py-3 text-base';
          buy.textContent = tr('status.buy_now');
          panel.append(buy);
        }
      }
      const pill = document.getElementById(`hero-pill-${type}`);
      const heroValue = document.getElementById(`hero-status-${type}`);
      if (pill) {
        pill.dataset.state = pass.state;
        pill.dataset.passState = pass.state;
      }
      if (heroValue) heroValue.textContent = formatPassLabel(pass, statusCopy);
    }

    function applyStatus(snapshot: StatusSnapshot) {
      updateCard('silver', snapshot);
      updateCard('gold', snapshot);
      const answer = formatStatusAnswer(snapshot, statusCopy, locale);
      const description = formatStatusDescription(snapshot, statusCopy);
      document.querySelectorAll<HTMLMetaElement>('meta[name="description"], meta[property="og:description"], meta[name="twitter:description"]').forEach((element) => {
        element.content = description;
      });
      document.querySelectorAll<HTMLElement>('[data-availability-answer]').forEach((element) => {
        element.textContent = answer;
      });
      const request = formatStatusRequest(snapshot, statusCopy, locale);
      for (const id of ['last-check-text', 'hero-status-time']) {
        const element = document.getElementById(id);
        if (element) element.textContent = request;
      }
      const faq = document.getElementById('availability-faq-schema');
      if (faq) {
        try {
          faq.textContent = JSON.stringify(updateAvailabilityFaq(JSON.parse(faq.textContent || '{}'), answer));
        } catch { /* A schema parsing failure must not obscure the visible current status. */ }
      }
      const webpage = document.getElementById('schema-webpage');
      if (webpage) {
        try {
          const schema = JSON.parse(webpage.textContent || '{}');
          schema.description = description;
          schema.dateModified = snapshot.capturedAt;
          webpage.textContent = JSON.stringify(schema);
        } catch {}
      }
      const app = document.getElementById('schema-webapp');
      if (app) {
        try {
          const schema = JSON.parse(app.textContent || '{}');
          schema.description = description;
          app.textContent = JSON.stringify(schema);
        } catch {}
      }
    }

    async function loadStatus() {
      try {
        const response = await fetch('/api/status', {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
          signal: AbortSignal.timeout(10_000),
        });
        if (!response.ok) throw new Error('status');
        applyStatus(snapshotFromPayload(await response.json(), new Date().toISOString()));
      } catch {
        // Keep confirmed observations in history; current availability is unknown
        // after a failed refresh, including tabs that previously showed a sale.
        applyStatus(createUnknownSnapshot(new Date().toISOString(), true));
      }
    }

    function countUp(el: HTMLElement, to: number, format: (n: number) => string) {
      if (prefersReduce) { el.textContent = format(to); return; }
      const duration = 1000;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = format(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    async function loadFanCount() {
      try {
        const response = await fetch('/api/subscriber-count');
        if (!response.ok) return;
        const data = await response.json();
        const element = document.getElementById('fan-count');
        if (element && Number.isFinite(data.count) && data.count >= 0) {
          document.getElementById('hero-live-count')?.removeAttribute('hidden');
          countUp(element, data.count, (n) => n.toLocaleString(locale));
        }
      } catch {}
    }

    // Shared scroll-reveal — reveal-once, then unobserve.
    // Safety net: if IntersectionObserver never ticks (dead/unsupported), reveal everything
    // so content is never permanently stuck at opacity:0.
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const revealAll = () => revealEls.forEach((el) => el.classList.add('is-in'));
    if (prefersReduce || !('IntersectionObserver' in window)) {
      revealAll();
    } else {
      let ioAlive = false;
      const revealObserver = new IntersectionObserver((entries, obs) => {
        ioAlive = true;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            obs.unobserve(entry.target);
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      revealEls.forEach((el) => revealObserver.observe(el));
      window.setTimeout(() => { if (!ioAlive) revealAll(); }, 1500);
    }

    loadStatus();
    loadFanCount();
    window.setInterval(loadStatus, 5 * 60 * 1000);

    const stickyCta = document.getElementById('sticky-cta');
    const subscribeSection = document.getElementById('benachrichtigung');
    const heroCta = document.getElementById('hero-cta');
    const footer = document.querySelector('footer');

    if (stickyCta && subscribeSection && heroCta) {
      let heroVisible = true;
      let subscribeVisible = false;
      let footerVisible = false;
      const updateSticky = () => {
        const hide = heroVisible || subscribeVisible || footerVisible;
        stickyCta.toggleAttribute('inert', hide);
        stickyCta.setAttribute('aria-hidden', String(hide));
        stickyCta.classList.toggle('opacity-0', hide);
        stickyCta.classList.toggle('translate-y-full', hide);
        stickyCta.classList.toggle('opacity-100', !hide);
        stickyCta.classList.toggle('translate-y-0', !hide);
      };
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.target === heroCta) heroVisible = entry.isIntersecting;
          if (entry.target === subscribeSection) subscribeVisible = entry.isIntersecting;
          if (entry.target === footer) footerVisible = entry.isIntersecting;
        }
        updateSticky();
      }, { threshold: 0.1 });
      observer.observe(heroCta);
      observer.observe(subscribeSection);
      if (footer) observer.observe(footer);
    }
  </script>
</Layout>

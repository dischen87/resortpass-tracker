---
import { Icon } from 'astro-icon/components';
import { type Lang, defaultLang, getTranslation } from '../i18n/translations';
import { getLocaleDefinition } from '../i18n/locales';
import { getRoutePath } from '../i18n/routes';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang || defaultLang;
const tr = (key: string) => getTranslation(lang, key);
const formPath = getRoutePath('communityNew', lang)!;
const localeTag = getLocaleDefinition(lang).bcp47;
---

<section class="py-16 md:py-20" id="community">
  <div class="section-shell">

    <div class="text-center mb-10">
      <h2 class="section-heading mb-3">
        {tr('community.title')}
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto">{tr('community.desc')}</p>
    </div>

    <div class="max-w-2xl mx-auto reveal">
      <!-- Posts container (loaded via JS) -->
      <div id="community-posts" class="space-y-4 mb-6" aria-busy="true" aria-live="polite">
        <div class="skeleton community-skeleton" aria-hidden="true"></div>
        <div class="skeleton community-skeleton" aria-hidden="true"></div>
      </div>

      <p id="community-status" class="hidden text-center text-muted text-sm py-8"></p>

      <div id="community-load-more-wrap" class="text-center hidden mb-6">
        <button id="community-load-more" class="inline-flex items-center gap-1.5 rounded-full border-2 border-border bg-surface px-4 py-2 text-sm font-bold text-text-secondary transition hover:-translate-y-px hover:text-text-primary hover:shadow-[3px_3px_0_var(--color-accent)] cursor-pointer">
          {tr('community.load_more')}
          <Icon name="tabler:chevron-down" class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div class="text-center">
        <a
          href={formPath}
          class="btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm"
        >
          <Icon name="tabler:message-plus" class="h-4 w-4" aria-hidden="true" />
          {tr('community.share')}
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ lang, localeTag, emptyText: tr('community.empty'), errorText: tr('community.load_error') }}>
  window.__communityLang = lang;
  window.__communityEmpty = emptyText;
  window.__communityError = errorText;
</script>

<script>
  const lang = (window as any).__communityLang || 'de';
  const emptyText = (window as any).__communityEmpty || '';
  const errorText = (window as any).__communityError || '';
  const cardShadows = ['#C4B5FD', '#FDE68A', '#F9A8D4'];
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let offset = 0;
  const limit = 10;
  let total = 0;
  let firstLoad = true;

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function formatDate(dateStr: string) {
    const d = new Date(dateStr + 'Z');
    return d.toLocaleDateString(localeTag, { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function renderPost(post: { author_name: string; title: string; body: string; created_at: string }, index: number) {
    const shadow = cardShadows[index % cardShadows.length];
    const anim = prefersReduce ? '' : ` animate-fade-in-up`;
    return `
      <article class="card${anim} p-5" style="--card-shadow:${shadow}">
        <div class="min-w-0">
            <h3 class="text-sm font-bold mb-1 font-heading">${escapeHtml(post.title)}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-2 whitespace-pre-line">${escapeHtml(post.body)}</p>
            <p class="text-xs text-muted">${escapeHtml(post.author_name)} &middot; ${formatDate(post.created_at)}</p>
        </div>
      </article>
    `;
  }

  function showStatus(text: string) {
    const status = document.getElementById('community-status');
    if (status) { status.textContent = text; status.classList.remove('hidden'); }
  }

  function clearSkeleton(container: HTMLElement) {
    if (firstLoad) {
      container.innerHTML = '';
      container.removeAttribute('aria-busy');
      firstLoad = false;
    }
  }

  async function loadPosts(append = false) {
    const container = document.getElementById('community-posts')!;
    const loadMoreWrap = document.getElementById('community-load-more-wrap');
    try {
      const res = await fetch(`/api/community?limit=${limit}&offset=${offset}`);
      const data = await res.json();
      total = data.total || 0;

      if (data.posts && data.posts.length > 0) {
        const html = data.posts.map(renderPost).join('');
        if (append) {
          container.insertAdjacentHTML('beforeend', html);
        } else {
          clearSkeleton(container);
          container.innerHTML = html;
        }
        offset += data.posts.length;
        if (loadMoreWrap) loadMoreWrap.classList.toggle('hidden', offset >= total);
      } else if (offset === 0) {
        clearSkeleton(container);
        showStatus(emptyText);
      }
    } catch {
      if (offset === 0) {
        clearSkeleton(container);
        showStatus(errorText);
      }
    }
  }

  const loadMoreBtn = document.getElementById('community-load-more');
  loadMoreBtn?.addEventListener('click', () => loadPosts(true));

  loadPosts();
</script>

---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import StatusCard from '../../components/StatusCard.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import InfoSection from '../../components/InfoSection.astro';
import HistorySection from '../../components/HistorySection.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getTranslation } from '../../i18n/translations';

const lang = 'it' as const;
const tr = (key: string) => getTranslation(lang, key);
---

<Layout lang={lang}>
  <main class="max-w-2xl mx-auto">
    <Hero lang={lang} />

    <!-- Status Cards -->
    <section class="px-4 pb-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <StatusCard type="silver" lang={lang} />
        <StatusCard type="gold" lang={lang} />
      </div>

      <!-- Last check timestamp -->
      <div class="mt-5 flex items-center justify-center gap-2 text-xs text-muted font-mono" id="last-check">
        <svg class="animate-spin h-3 w-3" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span id="last-check-text">{tr('status.loading')}</span>
      </div>
    </section>

    <SubscribeForm lang={lang} />
    <InfoSection lang={lang} />
    <HistorySection lang={lang} />
    <Footer lang={lang} />
  </main>

  <!-- Structured Data: WebSite with SearchAction (sitelinks search box) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ResortPass Tracker",
    "alternateName": "Europa-Park Jahreskarte Tracker",
    "url": "https://www.resortpass-europapark.ch",
    "inLanguage": ["de", "fr", "it", "en"],
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.resortpass-europapark.ch/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Structured Data: ItemList for pass types -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Europa-Park ResortPass Varianten",
    "description": "Übersicht der verfügbaren ResortPass-Jahreskarten für den Europa-Park",
    "numberOfItems": 2,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Product",
          "name": "ResortPass Silver",
          "description": "Unbegrenzter Eintritt in den Europa-Park für eine volle Saison. Ohne Zugang zum Wasserpark Rulantica.",
          "url": "https://tickets.mackinternational.de/de/ticket/resortpass-silver",
          "brand": { "@type": "Brand", "name": "Europa-Park" },
          "offers": {
            "@type": "AggregateOffer",
            "lowPrice": "275",
            "highPrice": "325",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/OutOfStock",
            "seller": { "@type": "Organization", "name": "MackInternational" }
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Product",
          "name": "ResortPass Gold",
          "description": "Unbegrenzter Eintritt in den Europa-Park und den Wasserpark Rulantica für eine volle Saison.",
          "url": "https://tickets.mackinternational.de/de/ticket/resortpass-gold",
          "brand": { "@type": "Brand", "name": "Europa-Park" },
          "offers": {
            "@type": "AggregateOffer",
            "lowPrice": "430",
            "highPrice": "495",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/OutOfStock",
            "seller": { "@type": "Organization", "name": "MackInternational" }
          }
        }
      }
    ]
  })} />

  <!-- Structured Data: WebPage with dynamic dateModified -->
  <script type="application/ld+json" id="schema-webpage" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": tr('meta.title'),
    "url": "https://www.resortpass-europapark.ch/it/",
    "description": tr('meta.description'),
    "inLanguage": "it",
    "dateModified": new Date().toISOString(),
    "isPartOf": {
      "@type": "WebSite",
      "name": "ResortPass Tracker",
      "url": "https://www.resortpass-europapark.ch"
    }
  })} />

  <!-- Structured Data: WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ResortPass Tracker",
    "url": "https://www.resortpass-europapark.ch/it/",
    "description": tr('meta.description'),
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "inLanguage": "it",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "CHF" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".text-text-secondary", "#benachrichtigung h2"] }
  })} />

  <!-- Structured Data: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": tr('info.what_title'), "acceptedAnswer": { "@type": "Answer", "text": tr('info.what_text') } },
      { "@type": "Question", "name": tr('info.why_title'), "acceptedAnswer": { "@type": "Answer", "text": tr('info.why_text') } },
      { "@type": "Question", "name": tr('info.how_title'), "acceptedAnswer": { "@type": "Answer", "text": tr('info.how_text') } },
      { "@type": "Question", "name": "Quanto costa il ResortPass Silver?", "acceptedAnswer": { "@type": "Answer", "text": "Il ResortPass Silver costa 325 € per adulti (dai 12 anni) e 275 € per bambini (4–11 anni) e anziani (60+). Include l'accesso illimitato all'Europa-Park per un'intera stagione, senza accesso a Rulantica." } },
      { "@type": "Question", "name": "Quanto costa il ResortPass Gold?", "acceptedAnswer": { "@type": "Answer", "text": "Il ResortPass Gold costa 495 € per adulti (dai 12 anni) e 430 € per bambini (4–11 anni) e anziani (60+). Include l'accesso illimitato all'Europa-Park e al parco acquatico Rulantica." } },
      {
        "@type": "Question",
        "name": "Quando vengono rilasciati nuovi contingenti di ResortPass?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "L'Europa-Park rilascia solitamente nuovi contingenti all'inizio della stagione (marzo/aprile) e dopo la pausa estiva. Non c'è un annuncio ufficiale — la disponibilità appare improvvisamente nel negozio e spesso scompare in pochi giorni. Il nostro tracker controlla ogni 15 minuti e ti avvisa subito via e-mail."
        }
      },
      {
        "@type": "Question",
        "name": "Dove si può acquistare il ResortPass Europa-Park?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Il ResortPass può essere acquistato esclusivamente tramite il negozio online ufficiale di MackInternational (tickets.mackinternational.de). Non c'è vendita in loco e non ci sono rivenditori terzi."
        }
      },
      {
        "@type": "Question",
        "name": "Qual è la differenza tra ResortPass Silver e Gold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Il ResortPass Silver (da 275 €) offre accesso illimitato all'Europa-Park per una stagione. Il ResortPass Gold (da 430 €) include anche l'accesso illimitato al parco acquatico Rulantica. Entrambi sono validi per l'intera stagione e sono nominativi."
        }
      }
    ]
  })} />

  <!-- Status loader -->
  <script define:vars={{ lang }}>
    window.__statusLang = lang;
  </script>

  <script>
    import { getTranslation, type Lang } from '../../i18n/translations';

    const statusLang = (window as any).__statusLang as Lang || 'de';
    const tr = (key: string) => getTranslation(statusLang, key);

    async function loadStatus() {
      try {
        const res = await fetch('/api/status');
        const data = await res.json();

        updateCard('silver', data.silver);
        updateCard('gold', data.gold);

        const lastCheck = data.silver?.lastCheck || data.gold?.lastCheck;
        if (lastCheck) {
          const date = new Date(lastCheck + 'Z');
          const formatted = date.toLocaleDateString(statusLang, {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
          const textEl = document.getElementById('last-check-text');
          const containerEl = document.getElementById('last-check');
          if (textEl) textEl.textContent = `${tr('status.last_check')}: ${formatted} — ${tr('status.updated_3x')}`;
          const spinner = containerEl?.querySelector('svg');
          if (spinner) spinner.remove();

          const schemaEl = document.getElementById('schema-webpage');
          if (schemaEl) {
            try {
              const schema = JSON.parse(schemaEl.textContent || '{}');
              schema.dateModified = date.toISOString();
              schemaEl.textContent = JSON.stringify(schema);
            } catch {}
          }
        }
      } catch {
        const textEl = document.getElementById('last-check-text');
        const containerEl = document.getElementById('last-check');
        if (textEl) textEl.textContent = tr('status.error');
        const spinner = containerEl?.querySelector('svg');
        if (spinner) spinner.remove();
      }
    }

    function updateCard(type: string, status: { available: boolean; lastCheck: string } | undefined) {
      const card = document.getElementById(`card-${type}`);
      if (!card || !status) return;

      const loadingEl = card.querySelector('.status-loading');
      const unavailableEl = card.querySelector('.status-unavailable');
      const availableEl = card.querySelector('.status-available');
      const errorEl = card.querySelector('.status-error');

      loadingEl?.classList.add('hidden');

      if (status.available) {
        card.classList.add('card-available');
        unavailableEl?.classList.add('hidden');
        availableEl?.classList.remove('hidden');
        errorEl?.classList.add('hidden');
      } else {
        card.classList.add('card-unavailable');
        unavailableEl?.classList.remove('hidden');
        availableEl?.classList.add('hidden');
        errorEl?.classList.add('hidden');
      }
    }

    loadStatus();
    setInterval(loadStatus, 5 * 60 * 1000);
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatusCard from '../components/StatusCard.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import InfoSection from '../components/InfoSection.astro';
import HistorySection from '../components/HistorySection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getTranslation } from '../i18n/translations';

const lang = 'de' as const;
const tr = (key: string) => getTranslation(lang, key);
---

<Layout lang={lang}>
  <Navbar lang={lang} />

  <main>
    <Hero lang={lang} />

    <!-- Status Cards -->
    <section class="py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-heading);">Status</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
          <StatusCard type="silver" lang={lang} />
          <StatusCard type="gold" lang={lang} />
        </div>

        <!-- Last check timestamp -->
        <div class="mt-6 flex items-center justify-center gap-2 text-xs text-muted font-mono" id="last-check">
          <svg class="animate-spin h-3 w-3" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span id="last-check-text">{tr('status.loading')}</span>
        </div>
      </div>
    </section>

    <SubscribeForm lang={lang} />
    <InfoSection lang={lang} />
    <HistorySection lang={lang} />
    <Footer lang={lang} />
  </main>

  <!-- Sticky CTA Button -->
  <div id="sticky-cta" class="fixed bottom-0 left-0 right-0 z-50 pointer-events-none opacity-0 translate-y-full transition-all duration-300">
    <div class="max-w-6xl mx-auto px-4 pb-4 pt-2">
      <div class="pointer-events-auto max-w-md mx-auto">
        <a
          href="#benachrichtigung"
          class="btn-primary w-full py-4 rounded-2xl text-base"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span>{tr('subscribe.sticky_cta')}</span>
        </a>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/95 to-transparent pointer-events-none"></div>
  </div>

  <!-- Structured Data: WebSite with SearchAction (sitelinks search box) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ResortPass Tracker",
    "alternateName": "Europa-Park Jahreskarte Tracker",
    "url": "https://www.resortpass-europapark.ch",
    "inLanguage": ["de", "fr", "it", "en"],
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.resortpass-europapark.ch/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Structured Data: WebPage with dynamic dateModified -->
  <script type="application/ld+json" id="schema-webpage" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": tr('meta.title'),
    "url": "https://www.resortpass-europapark.ch/",
    "description": tr('meta.description'),
    "inLanguage": "de",
    "dateModified": new Date().toISOString(),
    "isPartOf": {
      "@type": "WebSite",
      "name": "ResortPass Tracker",
      "url": "https://www.resortpass-europapark.ch"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://www.resortpass-europapark.ch/"
      }]
    }
  })} />

  <!-- Structured Data: ItemList for pass types -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Europa-Park ResortPass Varianten",
    "description": "Übersicht der verfügbaren ResortPass-Jahreskarten für den Europa-Park",
    "numberOfItems": 2,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Product",
          "name": "ResortPass Silver",
          "description": "Unbegrenzter Eintritt in den Europa-Park für eine volle Saison. Ohne Zugang zum Wasserpark Rulantica.",
          "url": "https://tickets.mackinternational.de/de/ticket/resortpass-silver",
          "brand": { "@type": "Brand", "name": "Europa-Park" },
          "offers": {
            "@type": "AggregateOffer",
            "lowPrice": "275",
            "highPrice": "325",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/OutOfStock",
            "seller": { "@type": "Organization", "name": "MackInternational" }
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Product",
          "name": "ResortPass Gold",
          "description": "Unbegrenzter Eintritt in den Europa-Park und den Wasserpark Rulantica für eine volle Saison.",
          "url": "https://tickets.mackinternational.de/de/ticket/resortpass-gold",
          "brand": { "@type": "Brand", "name": "Europa-Park" },
          "offers": {
            "@type": "AggregateOffer",
            "lowPrice": "430",
            "highPrice": "495",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/OutOfStock",
            "seller": { "@type": "Organization", "name": "MackInternational" }
          }
        }
      }
    ]
  })} />

  <!-- Structured Data: WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ResortPass Tracker",
    "url": "https://www.resortpass-europapark.ch",
    "description": tr('meta.description'),
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "inLanguage": ["de", "fr", "it", "en"],
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "CHF"
    },
    "author": {
      "@type": "Person",
      "name": "Mathias Graf",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Seestrasse 21",
        "postalCode": "8703",
        "addressLocality": "Erlenbach",
        "addressCountry": "CH"
      }
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".text-text-secondary", "#benachrichtigung h2"]
    }
  })} />

  <!-- Structured Data: FAQPage for GEO / AI search engines -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": tr('info.what_title'),
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr('info.what_text')
        }
      },
      {
        "@type": "Question",
        "name": tr('info.why_title'),
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr('info.why_text')
        }
      },
      {
        "@type": "Question",
        "name": tr('info.how_title'),
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr('info.how_text')
        }
      },
      {
        "@type": "Question",
        "name": lang === 'de' ? 'Was kostet der ResortPass Silver?' : lang === 'fr' ? 'Combien coûte le ResortPass Silver?' : lang === 'it' ? 'Quanto costa il ResortPass Silver?' : 'How much does the ResortPass Silver cost?',
        "acceptedAnswer": {
          "@type": "Answer",
          "text": lang === 'de' ? 'Der ResortPass Silver kostet 325 € für Erwachsene (ab 12 Jahre) und 275 € für Kinder (4–11 Jahre) sowie Senioren (60+). Er beinhaltet unbegrenzten Eintritt in den Europa-Park für eine volle Saison, ohne Zugang zum Wasserpark Rulantica.' : lang === 'fr' ? 'Le ResortPass Silver coûte 325 € pour les adultes (dès 12 ans) et 275 € pour les enfants (4–11 ans) et seniors (60+). Il comprend un accès illimité à l\'Europa-Park pour toute une saison, sans accès à Rulantica.' : lang === 'it' ? 'Il ResortPass Silver costa 325 € per adulti (dai 12 anni) e 275 € per bambini (4–11 anni) e anziani (60+). Include l\'accesso illimitato all\'Europa-Park per un\'intera stagione, senza accesso a Rulantica.' : 'The ResortPass Silver costs €325 for adults (12+) and €275 for children (4–11) and seniors (60+). It includes unlimited entry to Europa-Park for an entire season, without access to the Rulantica water park.'
        }
      },
      {
        "@type": "Question",
        "name": lang === 'de' ? 'Was kostet der ResortPass Gold?' : lang === 'fr' ? 'Combien coûte le ResortPass Gold?' : lang === 'it' ? 'Quanto costa il ResortPass Gold?' : 'How much does the ResortPass Gold cost?',
        "acceptedAnswer": {
          "@type": "Answer",
          "text": lang === 'de' ? 'Der ResortPass Gold kostet 495 € für Erwachsene (ab 12 Jahre) und 430 € für Kinder (4–11 Jahre) sowie Senioren (60+). Er beinhaltet unbegrenzten Eintritt in den Europa-Park sowie den Wasserpark Rulantica.' : lang === 'fr' ? 'Le ResortPass Gold coûte 495 € pour les adultes (dès 12 ans) et 430 € pour les enfants (4–11 ans) et seniors (60+). Il comprend un accès illimité à l\'Europa-Park et au parc aquatique Rulantica.' : lang === 'it' ? 'Il ResortPass Gold costa 495 € per adulti (dai 12 anni) e 430 € per bambini (4–11 anni) e anziani (60+). Include l\'accesso illimitato all\'Europa-Park e al parco acquatico Rulantica.' : 'The ResortPass Gold costs €495 for adults (12+) and €430 for children (4–11) and seniors (60+). It includes unlimited entry to Europa-Park and the Rulantica water park.'
        }
      },
      {
        "@type": "Question",
        "name": "Wann werden neue ResortPass-Kontingente freigegeben?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Der Europa-Park gibt neue Kontingente erfahrungsgemäss zu Saisonbeginn (März/April) und nach der Sommerpause frei. Es gibt keine offizielle Ankündigung — die Verfügbarkeit taucht plötzlich im Ticketshop auf und ist oft innerhalb weniger Tage wieder erschöpft. Unser Tracker prüft alle 15 Minuten und benachrichtigt dich sofort per E-Mail."
        }
      },
      {
        "@type": "Question",
        "name": "Wo kann man den Europa-Park ResortPass kaufen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Der ResortPass kann ausschliesslich über den offiziellen Online-Ticketshop von MackInternational (tickets.mackinternational.de) gekauft werden. Es gibt keinen Verkauf vor Ort an der Kasse und keine Drittanbieter. Sobald neue Kontingente verfügbar sind, erscheint ein Kaufbutton auf der jeweiligen Produktseite."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist der Unterschied zwischen ResortPass Silver und Gold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Der ResortPass Silver (ab 275 €) gewährt unbegrenzten Eintritt in den Europa-Park für eine Saison. Der ResortPass Gold (ab 430 €) beinhaltet zusätzlich unbegrenzten Zugang zum Wasserpark Rulantica. Beide Pässe gelten für die gesamte Saison und sind personengebunden."
        }
      }
    ]
  })} />

  <!-- Status loader -->
  <script define:vars={{ lang }}>
    window.__statusLang = lang;
  </script>

  <script>
    import { getTranslation, type Lang } from '../i18n/translations';

    const statusLang = (window as any).__statusLang as Lang || 'de';
    const tr = (key: string) => getTranslation(statusLang, key);

    async function loadStatus() {
      try {
        const res = await fetch('/api/status');
        const data = await res.json();

        updateCard('silver', data.silver);
        updateCard('gold', data.gold);

        const lastCheck = data.silver?.lastCheck || data.gold?.lastCheck;
        if (lastCheck) {
          const date = new Date(lastCheck + 'Z');
          const locale = statusLang === 'de' ? 'de-CH' : statusLang;
          const formatted = date.toLocaleDateString(locale, {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
          const textEl = document.getElementById('last-check-text');
          const containerEl = document.getElementById('last-check');
          if (textEl) textEl.textContent = `${tr('status.last_check')}: ${formatted} — ${tr('status.updated_3x')}`;
          const spinner = containerEl?.querySelector('svg');
          if (spinner) spinner.remove();

          const schemaEl = document.getElementById('schema-webpage');
          if (schemaEl) {
            try {
              const schema = JSON.parse(schemaEl.textContent || '{}');
              schema.dateModified = date.toISOString();
              schemaEl.textContent = JSON.stringify(schema);
            } catch {}
          }
        }
      } catch {
        const textEl = document.getElementById('last-check-text');
        const containerEl = document.getElementById('last-check');
        if (textEl) textEl.textContent = tr('status.error');
        const spinner = containerEl?.querySelector('svg');
        if (spinner) spinner.remove();
      }
    }

    function updateCard(type: string, status: { available: boolean; lastCheck: string } | undefined) {
      const card = document.getElementById(`card-${type}`);
      if (!card || !status) return;

      const loadingEl = card.querySelector('.status-loading');
      const unavailableEl = card.querySelector('.status-unavailable');
      const availableEl = card.querySelector('.status-available');
      const errorEl = card.querySelector('.status-error');

      loadingEl?.classList.add('hidden');

      if (status.available) {
        card.classList.add('card-available');
        unavailableEl?.classList.add('hidden');
        availableEl?.classList.remove('hidden');
        errorEl?.classList.add('hidden');
      } else {
        card.classList.add('card-unavailable');
        unavailableEl?.classList.remove('hidden');
        availableEl?.classList.add('hidden');
        errorEl?.classList.add('hidden');
      }
    }

    loadStatus();
    setInterval(loadStatus, 5 * 60 * 1000);

    // Load subscriber count
    async function loadFanCount() {
      try {
        const res = await fetch('/api/subscriber-count');
        const data = await res.json();
        const el = document.getElementById('fan-count');
        if (el && data.count !== undefined) {
          el.textContent = data.count.toLocaleString('de-CH');
        }
      } catch {}
    }
    loadFanCount();

    // Sticky CTA: show only when both hero CTA and subscribe form are out of view
    const stickyCta = document.getElementById('sticky-cta');
    const subscribeSection = document.getElementById('benachrichtigung');
    const heroCta = document.getElementById('hero-cta');

    if (stickyCta && subscribeSection) {
      let heroVisible = true;
      let subscribeVisible = false;

      function updateStickyCta() {
        if (heroVisible || subscribeVisible) {
          stickyCta!.classList.add('opacity-0', 'translate-y-full');
          stickyCta!.classList.remove('opacity-100', 'translate-y-0');
        } else {
          stickyCta!.classList.remove('opacity-0', 'translate-y-full');
          stickyCta!.classList.add('opacity-100', 'translate-y-0');
        }
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.target === subscribeSection) subscribeVisible = entry.isIntersecting;
            if (entry.target === heroCta) heroVisible = entry.isIntersecting;
          }
          updateStickyCta();
        },
        { threshold: 0.1 }
      );
      observer.observe(subscribeSection);
      if (heroCta) observer.observe(heroCta);

      stickyCta.querySelector('a')?.addEventListener('click', (e) => {
        e.preventDefault();
        subscribeSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          const emailInput = document.getElementById('email') as HTMLInputElement;
          emailInput?.focus();
        }, 600);
      });
    }
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const lang = 'de' as const;
---

<Layout lang={lang} title="404 — Seite nicht gefunden" description="Die gesuchte Seite wurde nicht gefunden." noindex>
  <Navbar lang={lang} />
  <main id="main-content" class="max-w-2xl mx-auto px-4 py-16 text-center md:py-20">
    <div class="glass-card rounded-2xl p-8 md:p-12 max-w-md mx-auto shadow-[5px_5px_0_#F9A8D4] animate-fade-in-up">

      <!-- 404 Number -->
      <Icon name="tabler:route-off" class="mx-auto mb-4 h-14 w-14 text-pink" aria-hidden="true" />
      <div class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.2em] text-accent">404</div>

      <h1 class="text-2xl font-bold mb-3">Seite nicht gefunden</h1>

      <p class="text-text-secondary text-sm mb-8 leading-relaxed">
        Diese Seite existiert leider nicht — aber der Europa-Park schon!
        Vielleicht suchst du unseren ResortPass Tracker?
      </p>

      <a
        href="/"
        class="btn-primary"
      >
        <span>Zur Startseite</span>
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </main>
</Layout>
